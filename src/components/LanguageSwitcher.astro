---
import type { Locale } from '../i18n/types';
import { getTranslations, alternateLocalePath } from '../i18n';

interface Props {
  locale: Locale;
  /** A single link to the other language instead of the two-language switch */
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const t = getTranslations(locale);
const alternate = alternateLocalePath(locale, Astro.url.pathname);
const other = locale === 'fa' ? 'en' : 'fa';
---

{compact ? (
  <a
    href={alternate}
    class="lang-switch-compact"
    hreflang={other}
    lang={other}
    title={other === 'en' ? t.langSwitch.toEn : t.langSwitch.toFa}
  >
    {other === 'en' ? 'EN' : 'فا'}
  </a>
) : (

<div class="lang-switch" role="group" aria-label={t.langSwitch.label}>
  <a
    href={locale === 'fa' ? Astro.url.pathname : alternate}
    hreflang="fa"
    lang="fa"
    aria-current={locale === 'fa' ? 'page' : undefined}
  >
    {t.langSwitch.toFa}
  </a>
  <a
    href={locale === 'en' ? Astro.url.pathname : alternate}
    hreflang="en"
    lang="en"
    aria-current={locale === 'en' ? 'page' : undefined}
  >
    {t.langSwitch.toEn}
  </a>
</div>
)}
