---
import type { Locale } from '../i18n/types';
import { getTranslations, alternateLocalePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const alternate = alternateLocalePath(locale, Astro.url.pathname);
const alternateLocale: Locale = locale === 'fa' ? 'en' : 'fa';
const label = alternateLocale === 'en' ? t.langSwitch.toEn : t.langSwitch.toFa;
---

<div class="flex items-center rounded-lg border border-theme bg-[var(--toggle-bg)] p-0.5 text-xs font-semibold">
  <a
    href={locale === 'fa' ? Astro.url.pathname : alternate}
    class:list={[
      'rounded-md px-2.5 py-1.5 transition',
      locale === 'fa' ? 'bg-accent-gold/20 text-gold-emphasis' : 'text-muted hover:text-heading',
    ]}
    hreflang="fa"
    aria-current={locale === 'fa' ? 'page' : undefined}
  >
    FA
  </a>
  <a
    href={locale === 'en' ? Astro.url.pathname : alternate}
    class:list={[
      'rounded-md px-2.5 py-1.5 transition',
      locale === 'en' ? 'bg-accent-gold/20 text-gold-emphasis' : 'text-muted hover:text-heading',
    ]}
    hreflang="en"
    aria-current={locale === 'en' ? 'page' : undefined}
  >
    EN
  </a>
</div>
