---
import { getCollection } from 'astro:content';
import SectionBadge from './SectionBadge.astro';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath, getArticleDisplay } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const posts = (await getCollection('articles'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

{
  posts.length > 0 && (
    <section class="section-spacing relative">
      <div class="chart-pattern absolute inset-0 opacity-20" aria-hidden="true" />
      <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <SectionBadge label={t.news.badge} />
            <h2 class="section-title">
              {t.news.title} <span class="section-title-accent">{t.news.titleAccent}</span>
            </h2>
            <p class="section-subtitle">{t.news.subtitle}</p>
          </div>
          <a href={localePath(locale, '/articles')} class="btn-ghost">{t.news.viewAll}</a>
        </div>

        <div class="section-body-gap grid gap-5 sm:grid-cols-2 sm:gap-6">
          {posts.map((post) => {
            const display = getArticleDisplay(locale, post.id, {
              title: post.data.title,
              excerpt: post.data.excerpt,
              dateFa: post.data.dateFa,
            });
            return (
              <a
                href={localePath(locale, `/articles/${post.id}`)}
                class="investment-card group overflow-hidden rounded-2xl transition hover:-translate-y-1"
              >
                <img src={post.data.image} alt={display.title} class="aspect-video w-full object-cover transition group-hover:scale-[1.02]" loading="lazy" />
                <div class="p-6">
                  <time class="text-xs font-medium text-accent-gold" datetime={post.data.date.toISOString()}>
                    {display.dateLabel}
                  </time>
                  <h3 class="mt-2 text-lg font-bold text-heading group-hover:text-accent-gold-light">{display.title}</h3>
                  <p class="mt-2 line-clamp-2 text-sm text-muted">{display.excerpt}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )
}
