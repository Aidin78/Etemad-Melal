---
import { getSortedArticles } from '../lib/articles';
import HomeSectionHead from './HomeSectionHead.astro';
import NewsCard from './NewsCard.astro';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath } from '../i18n';
import { homepageArticleCount } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const [lead, ...rest] = (await getSortedArticles(locale)).slice(0, homepageArticleCount);
---

{
  lead && (
    <section class="home-section" data-pointer>
      <div class="home-wrap">
        <HomeSectionHead
          locale={locale}
          index={5}
          badge={t.news.badge}
          title={t.news.title}
          titleAccent={t.news.titleAccent}
          subtitle={t.news.subtitle}
        >
          <a slot="aside" href={localePath(locale, '/articles')} class="sh-link">{t.news.viewAll}</a>
        </HomeSectionHead>

        <div class="news-grid">
          <NewsCard locale={locale} post={lead} variant="lead" data-reveal data-spotlight="spill" />

          {rest.length > 0 && (
            <ul class="news-rest" data-reveal="cascade">
              {rest.map((post) => (
                <li>
                  <NewsCard locale={locale} post={post} variant="row" data-spotlight="spill" />
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </section>
  )
}
