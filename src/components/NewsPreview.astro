---
import { getSortedArticles } from '../lib/articles';
import { parseArticleId } from '../lib/article-utils';
import HomeSectionHead from './HomeSectionHead.astro';
import type { Locale } from '../i18n/types';
import { getArticleDisplay, getTranslations, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const posts = (await getSortedArticles(locale)).slice(0, 2).map((post) => ({
  post,
  slug: parseArticleId(post.id).slug,
  display: getArticleDisplay(locale, {
    title: post.data.title,
    excerpt: post.data.excerpt,
    date: post.data.date,
    dateFa: post.data.dateFa,
  }),
}));
---

{
  posts.length > 0 && (
    <section class="home-section">
      <div class="home-wrap">
        <HomeSectionHead
          locale={locale}
          index={5}
          badge={t.news.badge}
          title={t.news.title}
          titleAccent={t.news.titleAccent}
          subtitle={t.news.subtitle}
        >
          <a slot="aside" href={localePath(locale, '/articles')} class="sh-link">{t.news.viewAll}</a>
        </HomeSectionHead>

        <ul class="news-list">
          {posts.map(({ post, slug, display }) => (
            <li data-reveal>
              <a href={localePath(locale, `/articles/${slug}`)} class="news-item">
                <span class="news-media">
                  <img src={post.data.image} alt={display.title} loading="lazy" />
                </span>
                <time class="news-date" datetime={post.data.date.toISOString()}>{display.dateLabel}</time>
                <h3 class="news-title">{display.title}</h3>
                <p class="news-excerpt">{display.excerpt}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
