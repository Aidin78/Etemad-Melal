---
import { getSortedArticles } from '../lib/articles';
import SectionHeader from './SectionHeader.astro';
import NewsCard from './NewsCard.astro';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const posts = (await getSortedArticles(locale)).slice(0, 2);
---

{
  posts.length > 0 && (
    <section class="section-spacing relative">
      <div class="chart-pattern absolute inset-0 opacity-20" aria-hidden="true" />
      <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
        <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-end sm:justify-between">
          <div>
            <SectionHeader
              badge={t.news.badge}
              title={t.news.title}
              titleAccent={t.news.titleAccent}
              subtitle={t.news.subtitle}
            />
          </div>
          <a href={localePath(locale, '/articles')} class="btn-ghost shrink-0 justify-center max-sm:w-full">{t.news.viewAll}</a>
        </div>

        <div class="section-body-gap grid gap-5 sm:grid-cols-2 sm:gap-6">
          {posts.map((post) => (
            <NewsCard locale={locale} post={post} compact />
          ))}
        </div>
      </div>
    </section>
  )
}
