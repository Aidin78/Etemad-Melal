---
import HomeSectionHead from './HomeSectionHead.astro';
import OrbitMark from './OrbitMark.astro';
import Photo from './Photo.astro';
import PanelLink from './PanelLink.astro';
import ScrollWords from './ScrollWords.astro';
import { siteImages } from '../config/images';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath, formatBoxIndex } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const b = t.about.bridge;

const icons = {
  investor:
    'M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z',
  industry:
    'M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21',
};
---

<section id="about-preview" class="home-section band-dark manifesto" data-pointer>
  <OrbitMark class="orbit-mark--manifesto" />
  <div class="home-wrap">
    <HomeSectionHead locale={locale} index={4} badge={t.about.badge} title={t.about.title} titleAccent={t.about.titleAccent} />

    <!-- Capital ↔ Etemad Melal ↔ industry: the "bridge" the title talks about -->
    <div class="bridge" data-reveal="fade">
      <div class="bridge-node">
        <span class="bridge-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d={icons.investor} />
          </svg>
        </span>
        <strong>{b.investor}</strong>
        <small>{b.investorSub}</small>
      </div>

      <div class="bridge-link" aria-hidden="true">
        <span class="bridge-flow bridge-flow--out"><em>{b.flowOut}</em><i></i><i></i></span>
        <span class="bridge-flow bridge-flow--back"><em>{b.flowBack}</em><i></i><i></i></span>
      </div>

      <div class="bridge-node bridge-node--hub">
        <span class="bridge-hub">
          <OrbitMark class="bridge-hub-mark" withCenter />
        </span>
        <strong>{b.hub}</strong>
        <small>{b.hubSub}</small>
      </div>

      <div class="bridge-link" aria-hidden="true">
        <span class="bridge-flow bridge-flow--out"><em>{b.flowOut}</em><i></i><i></i></span>
        <span class="bridge-flow bridge-flow--back"><em>{b.flowBack}</em><i></i><i></i></span>
      </div>

      <div class="bridge-node">
        <span class="bridge-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" d={icons.industry} />
          </svg>
        </span>
        <strong>{b.industry}</strong>
        <small>{b.industrySub}</small>
      </div>
    </div>

    <div class="manifesto-grid">
      <div class="manifesto-copy">
        <ScrollWords text={t.about.subtitle} class="manifesto-text" />
        <p class="manifesto-body" data-reveal>{t.about.body}</p>

        <dl class="manifesto-highlights" data-reveal="cascade">
          {
            t.about.highlights.map((h, i) => (
              <div>
                <span class="manifesto-highlight-num">{formatBoxIndex(i + 1, locale)}</span>
                <dt>{h.label}</dt>
                <dd>{h.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="manifesto-actions" data-reveal>
          <a href={localePath(locale, '/about')} class="btn-primary">{t.about.ctaLearnMore}</a>
          <PanelLink locale={locale} variant="outline" signup>{t.about.ctaStart}</PanelLink>
        </div>
      </div>

      <figure class="manifesto-figure">
        <div class="manifesto-media" data-scrub>
          <Photo src={siteImages.about} alt={t.about.imageAlt} class="manifesto-img" loading="lazy" sizes="(min-width: 1024px) 42vw, 100vw" />
        </div>
      </figure>
    </div>
  </div>
</section>
