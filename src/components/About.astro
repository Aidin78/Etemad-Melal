---
import SectionHeader from './SectionHeader.astro';
import PanelLink from './PanelLink.astro';
import { siteImages } from '../config/images';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="about-preview" class="section-spacing relative overflow-hidden">
  <div class="glow-orb right-0 top-1/4 h-56 w-56 bg-primary/25"></div>
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="relative order-2 overflow-hidden rounded-2xl ring-1 ring-accent-gold/20 lg:order-1">
        <img src={siteImages.about} alt={t.about.imageAlt} class="aspect-[4/3] w-full object-cover" loading="lazy" />
        <div class="absolute inset-0 bg-image-overlay-top"></div>
        <div class="absolute bottom-4 right-4 left-4 grid grid-cols-3 gap-2">
          {
            t.about.highlights.map((h) => (
              <div class="glass-card rounded-lg p-3 text-center">
                <p class="text-[10px] text-subtle max-sm:text-xs">{h.label}</p>
                <p class="mt-0.5 text-xs font-bold text-accent-gold-light">{h.value}</p>
              </div>
            ))
          }
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <SectionHeader
          badge={t.about.badge}
          title={t.about.title}
          titleAccent={t.about.titleAccent}
          subtitle={t.about.subtitle}
        />
        <p class="mt-4 text-sm leading-relaxed text-muted">{t.about.body}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={localePath(locale, '/about')} class="btn-primary">{t.about.ctaLearnMore}</a>
          <PanelLink locale={locale} variant="outline">{t.about.ctaStart}</PanelLink>
        </div>
      </div>
    </div>
  </div>
</section>
