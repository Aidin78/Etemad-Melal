---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/types';
import { getArticleDisplay, getTranslations, localePath } from '../i18n';
import { parseArticleId } from '../lib/article-utils';

interface Props extends HTMLAttributes<'a'> {
  locale: Locale;
  post: CollectionEntry<'articles'>;
  /**
   * lead: large photo above the text · feature: lead with the text beside it on wide screens
   * card: grid item · row: text beside a small thumbnail, no excerpt
   */
  variant?: 'lead' | 'feature' | 'card' | 'row';
  as?: 'h2' | 'h3';
}

const { locale, post, variant = 'card', as: Title = 'h3', ...attrs } = Astro.props;
const t = getTranslations(locale);
const { slug } = parseArticleId(post.id);
const display = getArticleDisplay(locale, {
  title: post.data.title,
  excerpt: post.data.excerpt,
  date: post.data.date,
  dateFa: post.data.dateFa,
});
const href = localePath(locale, `/articles/${slug}`);
const leading = variant === 'lead' || variant === 'feature';
---

{
  variant === 'row' ? (
    <a href={href} class="news-row" {...attrs}>
      <div>
        <time class="news-date" datetime={post.data.date.toISOString()}>{display.dateLabel}</time>
        <Title class="news-title">{display.title}</Title>
      </div>
      <span class="news-media">
        <img src={post.data.image} alt="" loading="lazy" />
      </span>
    </a>
  ) : (
    <a href={href} class:list={[leading ? 'news-lead' : 'news-card', variant === 'feature' && 'news-lead--feature']} {...attrs}>
      <span class="news-media">
        <img src={post.data.image} alt="" loading={variant === 'feature' ? 'eager' : 'lazy'} />
      </span>
      <div>
        <time class="news-date" datetime={post.data.date.toISOString()}>{display.dateLabel}</time>
        <Title class="news-title">{display.title}</Title>
        <p class="news-excerpt">{display.excerpt}</p>
        {leading && <span class="news-more">{t.news.readMore}</span>}
      </div>
    </a>
  )
}
