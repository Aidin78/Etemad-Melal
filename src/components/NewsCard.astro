---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'articles'>;
}

const { post } = Astro.props;
---

<a
  href={`/articles/${post.id}`}
  class="investment-card group overflow-hidden rounded-2xl transition hover:-translate-y-1"
>
  <img
    src={post.data.image}
    alt={post.data.title}
    class="aspect-video w-full object-cover transition group-hover:scale-[1.02]"
    loading="lazy"
  />
  <div class="p-6">
    <time class="text-xs font-medium text-accent-gold" datetime={post.data.date.toISOString()}>
      {post.data.dateFa}
    </time>
    <h2 class="mt-2 text-xl font-bold text-white group-hover:text-accent-gold-light">
      {post.data.title}
    </h2>
    <p class="mt-2 text-sm leading-relaxed text-zinc-400">{post.data.excerpt}</p>
    <span class="mt-4 inline-block text-sm font-bold text-accent">ادامه مطلب ←</span>
  </div>
</a>
