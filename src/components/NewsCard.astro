---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/types';
import { getArticleDisplay, getTranslations, localePath } from '../i18n';

interface Props {
  locale: Locale;
  post: CollectionEntry<'articles'>;
  compact?: boolean;
}

const { locale, post, compact = false } = Astro.props;
const t = getTranslations(locale);
const display = getArticleDisplay(locale, post.id, {
  title: post.data.title,
  excerpt: post.data.excerpt,
  date: post.data.date,
  dateFa: post.data.dateFa,
});
const TitleTag = compact ? 'h3' : 'h2';
const titleClass = compact
  ? 'mt-2 text-lg font-bold text-heading group-hover:text-accent-gold-light'
  : 'mt-2 text-xl font-bold text-heading group-hover:text-accent-gold-light';
---

<a
  href={localePath(locale, `/articles/${post.id}`)}
  class="investment-card group overflow-hidden rounded-2xl transition hover:-translate-y-1"
>
  <img src={post.data.image} alt={display.title} class="aspect-video w-full object-cover transition group-hover:scale-[1.02]" loading="lazy" />
  <div class="p-6">
    <time class="text-xs font-medium text-accent-gold" datetime={post.data.date.toISOString()}>
      {display.dateLabel}
    </time>
    <TitleTag class={titleClass}>{display.title}</TitleTag>
    <p class:list={['mt-2 text-sm text-muted', compact && 'line-clamp-2']}>{display.excerpt}</p>
    {!compact && <span class="mt-4 inline-block text-sm font-bold text-accent">{t.news.readMore}</span>}
  </div>
</a>
