---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import IncomeStreams from '../components/IncomeStreams.astro';
import Features from '../components/Features.astro';
import Trust from '../components/Trust.astro';
import About from '../components/About.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import NewsPreview from '../components/NewsPreview.astro';
import type { Locale } from '../i18n';
import { getTranslations } from '../i18n';
import { homepageFaqCount } from '../config/site';
import {
  organizationSchema,
  websiteSchema,
  financialServiceSchema,
  faqPageSchema,
} from '../lib/seo-schemas';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<Layout
  locale={locale}
  title={t.tagline}
  description={t.longDescription}
  jsonLd={[
    organizationSchema(locale, t),
    websiteSchema(locale, t),
    financialServiceSchema(locale, t),
    faqPageSchema(t.faqPage.items.slice(0, homepageFaqCount)),
  ]}
>
  <div class="home">
    <Hero locale={locale} />
    <IncomeStreams locale={locale} />
    <Features locale={locale} />
    <Trust locale={locale} />
    <About locale={locale} />
    <NewsPreview locale={locale} />
    <FAQ locale={locale} />
    <Contact locale={locale} />
  </div>

  <script>
    import { getYearsActive } from '../lib/dates';
    import { toLocaleDigits } from '../i18n/utils';
    import type { Locale } from '../i18n/types';

    // The page is only built once: recount here so the stat rolls over on the anniversary without a rebuild
    const years = toLocaleDigits(getYearsActive(), document.documentElement.lang.slice(0, 2) as Locale);
    document.querySelectorAll<HTMLElement>('[data-years]').forEach((el) => {
      el.textContent = el.dataset.years?.replace('{years}', years) ?? el.textContent;
    });
  </script>
</Layout>
