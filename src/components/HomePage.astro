---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import InvestmentTicker from '../components/InvestmentTicker.astro';
import IncomeStreams from '../components/IncomeStreams.astro';
import Features from '../components/Features.astro';
import Packages from '../components/Packages.astro';
import Trust from '../components/Trust.astro';
import About from '../components/About.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import NewsPreview from '../components/NewsPreview.astro';
import type { Locale } from '../i18n';
import { getTranslations } from '../i18n';
import {
  organizationSchema,
  websiteSchema,
  financialServiceSchema,
  faqPageSchema,
} from '../lib/seo-schemas';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<Layout
  locale={locale}
  title={t.siteName}
  description={t.longDescription}
  jsonLd={[
    organizationSchema(locale, t),
    websiteSchema(locale, t),
    financialServiceSchema(locale, t),
    faqPageSchema(t),
  ]}
>
  <Hero locale={locale} />
  <InvestmentTicker locale={locale} />
  <IncomeStreams locale={locale} />
  <Features locale={locale} />
  <Packages locale={locale} />
  <Trust locale={locale} />
  <About locale={locale} />
  <NewsPreview locale={locale} />
  <FAQ locale={locale} />
  <Contact locale={locale} />
</Layout>
