---
import SectionHeader from './SectionHeader.astro';
import PanelLink from './PanelLink.astro';
import type { Locale } from '../i18n/types';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="income-streams" class="section-spacing relative overflow-hidden">
  <div class="glow-orb -left-20 top-1/2 h-64 w-64 bg-accent/20"></div>
  <div class="glow-orb -right-20 top-0 h-48 w-48 bg-accent-gold/15"></div>
  <div class="chart-pattern absolute inset-0 opacity-40" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <SectionHeader
        badge={t.income.badge}
        title={t.income.title}
        titleAccent={t.income.titleAccent}
        subtitle={t.income.subtitle}
        align="center"
      />
    </div>

    <div class="section-body-gap grid gap-5 sm:gap-6 lg:grid-cols-2">
      {
        t.income.streams.map((stream) => (
          <article class="investment-card group flex flex-col rounded-2xl p-6">
            <div class="h-1.5 w-16 rounded-full transition-all duration-700 ease-out group-hover:w-[4.5rem]" style={`background: linear-gradient(90deg, ${stream.color}, transparent)`} />
            <div
              class="mt-5 flex h-12 w-12 items-center justify-center rounded-xl border transition-all duration-700 ease-out group-hover:scale-[1.03]"
              style={`background-color: color-mix(in srgb, ${stream.color} 18%, transparent); border-color: color-mix(in srgb, ${stream.color} 35%, transparent); color: ${stream.color}`}
            >
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={stream.icon} />
              </svg>
            </div>
            <h3 class="mt-4 text-lg font-bold leading-snug text-heading sm:text-xl">{stream.title}</h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{stream.desc}</p>
            {
              stream.highlights.length > 0 && (
                <ul class="mt-5 space-y-2 border-t border-divider pt-5">
                  {stream.highlights.map((h) => (
                    <li class="flex gap-2 text-xs text-body">
                      <span class="mt-1 h-1 w-1 shrink-0 rounded-full" style={`background: ${stream.color}`} />
                      {h}
                    </li>
                  ))}
                </ul>
              )
            }
          </article>
        ))
      }
    </div>

    <p class="mt-6 text-center text-xs text-subtle sm:mt-8">{t.income.footnote}</p>
    <div class="mt-6 text-center sm:mt-8">
      <PanelLink locale={locale} showArrow>
        {t.panelCtaLogin}
      </PanelLink>
    </div>
  </div>
</section>
