---
import HomeSectionHead from './HomeSectionHead.astro';
import PanelLink from './PanelLink.astro';
import type { Locale } from '../i18n/types';
import { getTranslations, formatBoxIndex } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

// Decorative hairline visuals per stream: rising production bars / a growing referral network
const bars = [34, 48, 42, 60, 72, 66, 84, 100];
const nodes = [
  { x: 50, y: 50 },
  { x: 20, y: 26 },
  { x: 80, y: 22 },
  { x: 86, y: 70 },
  { x: 16, y: 74 },
  { x: 50, y: 92 },
  { x: 50, y: 8 },
];
---

<div id="income-streams" class="home-anchor" aria-hidden="true"></div>
<section class="home-section" data-stack>
  <div class="home-wrap">
    <HomeSectionHead
      locale={locale}
      index={1}
      badge={t.income.badge}
      title={t.income.title}
      titleAccent={t.income.titleAccent}
      subtitle={t.income.subtitle}
    />

    <ul class="pillars">
      {
        t.income.streams.map((stream, i) => (
          <li class="pillar" style={`--c: ${stream.color}`} data-reveal>
            <div class="pillar-top">
              <span class="pillar-num" aria-hidden="true">{formatBoxIndex(i + 1, locale)}</span>
              <svg class="pillar-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" d={stream.icon} />
              </svg>
            </div>

            <div class="pillar-visual" aria-hidden="true" data-reveal="fade">
              {i === 0 ? (
                <div class="pillar-bars">
                  {bars.map((h, b) => (
                    <i style={`--h: ${h}%; --b: ${b}`} />
                  ))}
                </div>
              ) : (
                <svg class="pillar-network" viewBox="0 0 100 100" fill="none">
                  {nodes.slice(1).map((n, k) => (
                    <line x1="50" y1="50" x2={n.x} y2={n.y} pathLength="1" style={`--b: ${k}`} />
                  ))}
                  {nodes.map((n, k) => (
                    <rect x={n.x - (k ? 2.5 : 4)} y={n.y - (k ? 2.5 : 4)} width={k ? 5 : 8} height={k ? 5 : 8} style={`--b: ${k}`} />
                  ))}
                </svg>
              )}
            </div>

            <h3 class="pillar-title">{stream.title}</h3>
            <p class="pillar-desc">{stream.desc}</p>
            {
              stream.highlights.length > 0 && (
                <ul class="mt-5 space-y-2 border-t border-divider pt-5">
                  {stream.highlights.map((h) => (
                    <li class="flex gap-2 text-xs text-body">
                      <span class="mt-1 h-1 w-1 shrink-0" style={`background: ${stream.color}`} />
                      {h}
                    </li>
                  ))}
                </ul>
              )
            }
          </li>
        ))
      }
    </ul>

    {t.income.footnote && <p class="mt-6 text-xs text-subtle">{t.income.footnote}</p>}
    <div class="home-cta-row" data-reveal="fade">
      <PanelLink locale={locale} showArrow signup>
        {t.panelCtaStart}
      </PanelLink>
    </div>
  </div>
</section>
