---
import { incomeStreams } from '../config/income-streams';

const items = [
  ...incomeStreams.map((s) => ({ label: s.title, trend: 'پنل اعتماد ملل' })),
  { label: 'شفافیت گزارش مالی', trend: 'لحظه‌ای' },
  { label: 'پکیج‌های سرمایه‌گذاری', trend: '۵ سطح' },
  { label: 'پشتیبانی', trend: 'تیکت پنل' },
];
---

<div
  class="ticker-viewport relative overflow-hidden border-y border-accent-gold/15 bg-ticker py-3"
  aria-hidden="true"
>
  <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 ticker-fade-start"></div>
  <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 ticker-fade-end"></div>

  <div class="ticker-viewport-inner">
    <div class="ticker-inner">
      <div class="ticker-group">
        {
          items.map((item) => (
            <span class="ticker-item">
              <span class="font-medium text-body">{item.label}</span>
              <span class="rounded-md bg-accent/15 px-2 py-0.5 text-xs font-bold text-accent">
                {item.trend}
              </span>
              <span class="ticker-sep">◆</span>
            </span>
          ))
        }
      </div>
      <div class="ticker-group" aria-hidden="true">
        {
          items.map((item) => (
            <span class="ticker-item">
              <span class="font-medium text-body">{item.label}</span>
              <span class="rounded-md bg-accent/15 px-2 py-0.5 text-xs font-bold text-accent">
                {item.trend}
              </span>
              <span class="ticker-sep">◆</span>
            </span>
          ))
        }
      </div>
    </div>
  </div>
</div>
