---
import type { Locale } from '../i18n/types';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
// Each band repeats its items so the scroll-driven slide never runs out of text
const repeats = 4;
---

<div class="marquee" data-scrub aria-hidden="true">
  <div class="marquee-band marquee-band--gold">
    <div class="marquee-row marquee-row--a">
      {Array.from({ length: repeats }, () =>
        t.ticker.map((item) => (
          <span class="marquee-item">
            {item.label}
            <span class="marquee-sep">◆</span>
          </span>
        )),
      )}
    </div>
  </div>
  <div class="marquee-band marquee-band--dark">
    <div class="marquee-row marquee-row--b">
      {Array.from({ length: repeats }, () =>
        t.ticker.map((item) => (
          <span class="marquee-item">
            {item.trend}
            <span class="marquee-sep">◆</span>
          </span>
        )),
      )}
    </div>
  </div>
</div>
