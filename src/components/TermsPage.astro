---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import DocToc from './DocToc.astro';
import Icon from './Icon.astro';
import AboutSectionContent from './AboutSectionContent.astro';
import { legalLastUpdated } from '../config/site';
import type { Locale } from '../i18n/types';
import { formatDate, getTranslations, localePath, toLocaleDigits, formatBoxIndex } from '../i18n';
import { splitTitleAccent } from '../lib/rich-text';
import { breadcrumbSchema } from '../lib/seo-schemas';
import { pageUrl } from '../lib/urls';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

// Section titles carry their own "۱. " / "1. " prefix — split it off so the number can be its own badge
const sections = t.termsPage.sections.map((section, i) => ({
  ...section,
  id: `section-${i + 1}`,
  number: formatBoxIndex(i + 1, locale),
  heading: section.title.replace(/^[\d۰-۹]+\.\s*/, ''),
}));

const wordCount = t.termsPage.sections.reduce((sum, s) => sum + s.body.split(/\s+/).length, 0);
const readingMinutes = Math.max(1, Math.round(wordCount / 200));
const meta = [
  `${t.termsPage.lastUpdatedLabel}: ${formatDate(new Date(legalLastUpdated), locale)}`,
  t.termsPage.sectionsCount.replace('{count}', toLocaleDigits(sections.length, locale)),
  t.termsPage.readingTime.replace('{min}', toLocaleDigits(readingMinutes, locale)),
];
---

<Layout
  locale={locale}
  title={t.termsPage.pageTitle}
  description={t.termsPage.pageSubtitle}
  footerCta={false}
  jsonLd={[
    breadcrumbSchema([
      { name: t.a11y.home, url: pageUrl(locale, '/') },
      { name: t.termsPage.pageTitle, url: pageUrl(locale, '/terms') },
    ]),
  ]}
>
  <PageHero locale={locale} badge={t.termsPage.badge} {...splitTitleAccent(t.termsPage.pageTitle)} subtitle={t.termsPage.pageSubtitle}>
    <button slot="aside" type="button" class="sh-link terms-print" data-terms-print hidden>{t.termsPage.print}</button>
    <ul class="page-meta" data-reveal="fade">
      {meta.map((item) => <li>{item}</li>)}
    </ul>
  </PageHero>

  <section>
    <div class="home-wrap doc-layout">
      <DocToc title={t.termsPage.tocTitle} items={sections.map((s) => ({ id: s.id, label: s.heading, number: s.number }))} />

      <div class="min-w-0">
        <ol class="terms-sections">
          {
            sections.map((s) => (
              <li id={s.id} class:list={['terms-section', s.important && 'terms-section--important']} data-reveal>
                <div class="terms-section-head">
                  <span class="terms-section-num" aria-hidden="true">{s.number}</span>
                  <div class="terms-section-heading">
                    {s.important && <p class="terms-important-label">{t.termsPage.importantLabel}</p>}
                    <h2 class="terms-section-title">
                      <span class="sr-only">{s.number}. </span>
                      {s.heading}
                    </h2>
                  </div>
                  <a href={`#${s.id}`} class="terms-anchor" data-copy-anchor aria-label={`${t.termsPage.copyLink}: ${s.heading}`}>
                    <Icon class="h-4 w-4" strokeWidth={1.75} d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                  </a>
                </div>
                <AboutSectionContent content={s.body} />
              </li>
            ))
          }
        </ol>

        <div class="page-cta terms-help" data-reveal>
          <div>
            <h2 class="page-cta-title">{t.termsPage.helpTitle}</h2>
            <p class="page-cta-sub">{t.termsPage.helpBody}</p>
          </div>
          <div class="page-cta-actions">
            <a href={localePath(locale, '/faq')} class="btn-primary">{t.termsPage.helpFaq}</a>
            <a href={localePath(locale, '/#contact')} class="btn-outline">{t.termsPage.helpContact}</a>
          </div>
        </div>
      </div>
    </div>
    <p class="sr-only" aria-live="polite" data-terms-status data-copied-label={t.termsPage.linkCopied}></p>
  </section>
</Layout>

<script>
  // Print / save-as-PDF (hidden without JS)
  const printButton = document.querySelector<HTMLButtonElement>('[data-terms-print]');
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', () => window.print());
  }

  // Section anchor: jump there and copy its link
  const status = document.querySelector<HTMLElement>('[data-terms-status]');
  document.querySelectorAll<HTMLAnchorElement>('[data-copy-anchor]').forEach((anchor) => {
    anchor.addEventListener('click', async () => {
      if (!navigator.clipboard) return;
      try {
        await navigator.clipboard.writeText(anchor.href);
      } catch {
        return;
      }
      anchor.classList.add('is-copied');
      if (status) status.textContent = status.dataset.copiedLabel ?? '';
      window.setTimeout(() => {
        anchor.classList.remove('is-copied');
        if (status) status.textContent = '';
      }, 1800);
    });
  });
</script>
