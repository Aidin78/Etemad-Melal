---
import SectionBadge from './SectionBadge.astro';

const benefits = [
  {
    title: 'امنیت و حفاظت',
    desc: 'زیرساخت امن برای داده‌ها و تراکنش‌های مالی شما با استانداردهای روز.',
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    title: 'شفافیت کامل',
    desc: 'گزارش‌های دقیق از سود، واریز و برداشت در هر لحظه در پنل کاربری.',
    icon: 'M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z',
  },
  {
    title: 'پشتیبانی اختصاصی',
    desc: 'تیم پشتیبانی آماده پاسخگویی به سوالات شما در مسیر سرمایه‌گذاری.',
    icon: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z',
  },
];

const stats = [
  { value: '۱۰۰۰+', label: 'سرمایه‌گذار فعال', trend: '↑' },
  { value: '۵+', label: 'سال تجربه', trend: '★' },
  { value: '۹۸٪', label: 'رضایت کاربران', trend: '♥' },
  { value: '۲۴/۷', label: 'دسترسی به پنل', trend: '◆' },
];
---

<section id="trust" class="section-spacing bg-gradient-to-b from-secondary/80 to-[#0b1219]">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <SectionBadge label="مزایای رقابتی" />
      <h2 class="section-title">
        چرا <span class="section-title-accent">اعتماد ملل؟</span>
      </h2>
      <p class="section-subtitle mx-auto">
        ترکیبی از تخصص مالی، فناوری مدرن و تعهد به شفافیت؛ برای سرمایه‌گذاری مطمئن‌تر.
      </p>
    </div>

    <div class="section-body-gap grid gap-5 sm:grid-cols-3 sm:gap-6">
      {
        benefits.map((b) => (
          <article class="investment-card rounded-2xl p-6 text-center transition hover:-translate-y-1">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-accent/20 to-accent-gold/20 text-accent ring-1 ring-accent/30">
              <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={b.icon} />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-white">{b.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{b.desc}</p>
          </article>
        ))
      }
    </div>

    <div class="relative mt-10 overflow-hidden rounded-2xl ring-1 ring-accent-gold/20 sm:mt-16" aria-hidden="true">
      <img
        src="/images/trust.jpg"
        alt=""
        class="absolute inset-0 h-full w-full object-cover opacity-25"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#0b1219] via-secondary/90 to-[#0b1219]"></div>
      <div class="relative grid grid-cols-2 gap-6 p-8 sm:grid-cols-4 sm:p-12">
        {
          stats.map((s) => (
            <div class="text-center">
              <span class="text-xs text-accent-gold">{s.trend}</span>
              <p class="stat-value mt-1">{s.value}</p>
              <p class="mt-2 text-sm text-zinc-400">{s.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
