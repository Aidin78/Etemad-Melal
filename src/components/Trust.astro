---
import SectionHeader from './SectionHeader.astro';
import { siteImages } from '../config/images';
import { trustBenefitIcons } from '../lib/section-icons';
import type { Locale } from '../i18n/types';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="trust" class="section-spacing relative overflow-hidden bg-trust-section">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="text-center">
      <SectionHeader
        badge={t.trust.badge}
        title={t.trust.title}
        titleAccent={t.trust.titleAccent}
        subtitle={t.trust.subtitle}
        align="center"
      />
    </div>

    <ul class="section-body-gap grid gap-5 sm:grid-cols-2 lg:grid-cols-3 sm:gap-6">
      {
        t.trust.benefits.map((b, i) => (
          <li>
            <article class="investment-card group rounded-2xl p-6 text-center">
              <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-accent/20 to-accent-gold/20 text-accent ring-1 ring-accent/30 transition-all duration-500 ease-out group-hover:ring-accent/45 group-hover:from-accent/28 group-hover:to-accent-gold/28">
                <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={trustBenefitIcons[i] ?? trustBenefitIcons[0]} />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-heading">{b.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{b.desc}</p>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="relative mt-10 overflow-hidden rounded-2xl ring-1 ring-accent-gold/20 sm:mt-16" aria-hidden="true">
      <img src={siteImages.trust} alt="" class="absolute inset-0 h-full w-full object-cover opacity-25" loading="lazy" />
      <div class="absolute inset-0 bg-image-overlay-horizontal"></div>
      <div class="trust-stats-band relative grid grid-cols-2 gap-6 p-8 sm:grid-cols-4 sm:p-12">
        {
          t.trust.stats.map((s) => (
            <div class="text-center">
              <span class="text-xs text-accent-gold">{s.trend}</span>
              <p class="stat-value mt-1">{s.value}</p>
              <p class="mt-2 text-sm text-muted">{s.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
