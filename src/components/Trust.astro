---
import HomeSectionHead from './HomeSectionHead.astro';
import { trustBenefitIcons } from '../lib/section-icons';
import type { Locale } from '../i18n/types';
import { getTranslations, toLocaleDigits, formatBoxIndex } from '../i18n';
import { getYearsActive } from '../lib/dates';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const yearsActive = toLocaleDigits(getYearsActive(), locale);
const [lead, ...rest] = t.trust.benefits;
---

<div id="trust" class="home-anchor" aria-hidden="true"></div>
<section class="home-section" data-stack>
  <div class="home-wrap">
    <HomeSectionHead
      locale={locale}
      index={3}
      badge={t.trust.badge}
      title={t.trust.title}
      titleAccent={t.trust.titleAccent}
      subtitle={t.trust.subtitle}
    />

    <dl class="tstats" data-reveal="fade">
      {
        t.trust.stats.map((s) => (
          <div class="tstat">
            <dt>
              <span class="tstat-trend" aria-hidden="true">{s.trend}</span>
              {s.label}
            </dt>
            <dd data-count>{s.value.replace('{years}', yearsActive)}</dd>
          </div>
        ))
      }
    </dl>

    <ul class="tgrid">
      {
        lead && (
          <li class="tcell tcell--lead" data-reveal="fade" data-spotlight>
            <svg class="tshield" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" data-reveal="draw">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" d={trustBenefitIcons[0]} pathLength="1" data-draw-line />
            </svg>
            <div>
              <span class="tcell-num" aria-hidden="true">{formatBoxIndex(1, locale)}</span>
              <h3 class="tcell-title tcell-title--lead">{lead.title}</h3>
              <p class="tcell-desc tcell-desc--lead">{lead.desc}</p>
            </div>
          </li>
        )
      }
      {
        rest.map((b, i) => (
          <li class="tcell" data-reveal="fade" data-spotlight>
            <div class="tcell-head">
              <span class="tcell-num" aria-hidden="true">{formatBoxIndex(i + 2, locale)}</span>
              <svg class="tcell-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" d={trustBenefitIcons[i + 1] ?? trustBenefitIcons[0]} />
              </svg>
            </div>
            <h3 class="tcell-title">{b.title}</h3>
            <p class="tcell-desc">{b.desc}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
