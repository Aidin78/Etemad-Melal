---
import Logo from './Logo.astro';
import PanelLink from './PanelLink.astro';
import OrbitMark from './OrbitMark.astro';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath } from '../i18n';

interface Props {
  locale: Locale;
  /** Leave out the call-to-action band on pages that close with their own */
  cta?: boolean;
}

const { locale, cta = true } = Astro.props;
const t = getTranslations(locale);
const year = new Date().getFullYear();
const contact = localePath(locale, '/#contact');
---

<footer class="site-footer" aria-label={t.footer.landmarkLabel}>
  {
    cta && (
      <div class="band-dark">
        <OrbitMark class="orbit-mark--footer" />
        <div class="footer-wrap">
          <div class="footer-cta" data-reveal="cascade">
            <div>
              <p class="footer-eyebrow">{t.footer.ctaEyebrow}</p>
              <h2 class="footer-cta-title">
                {t.footer.ctaTitle} <span class="footer-cta-accent">{t.footer.ctaTitleAccent}</span>
                {t.footer.ctaTitleSuffix}
              </h2>
              <p class="footer-cta-sub">{t.footer.ctaSubtitle}</p>
            </div>
            <div class="footer-cta-actions">
              <PanelLink locale={locale} showArrow class="justify-center">{t.panelCtaLogin}</PanelLink>
              <a href={contact} class="footer-text-link">{t.footer.ctaContact}</a>
            </div>
          </div>
        </div>
      </div>
    )
  }

  <div class="footer-wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <Logo locale={locale} size="lg" animated={false} class="mb-0" />
        <p class="mt-5 text-sm leading-relaxed text-muted">{t.tagline}</p>
        <p class="mt-2 text-xs text-subtle">{t.companyLegal}</p>
      </div>

      <nav aria-label={t.footer.quickLinks}>
        <h3 class="footer-heading">{t.footer.quickLinks}</h3>
        <ul class="footer-links">
          {
            t.nav.map((link) => (
              <li>
                <a href={localePath(locale, link.href)} class="footer-link">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h3 class="footer-heading">{t.footer.contactTitle}</h3>
        <ul class="space-y-4 text-sm">
          <li>
            <span class="block text-xs text-subtle">{t.contact.emailLabel}</span>
            <a href={`mailto:${t.contact.email}`} class="footer-link mt-1 inline-block text-body" dir="ltr">
              {t.contact.email}
            </a>
          </li>
          <li>
            <span class="block text-xs text-subtle">{t.contact.addressLabel}</span>
            <span class="mt-1 block leading-relaxed text-body">{t.contact.address}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="text-xs text-subtle">{year} © {t.companyLegal}. {t.footer.rights}</p>
      <ul class="footer-legal-list flex flex-wrap justify-center gap-4 text-xs text-subtle">
        <li><a href={localePath(locale, '/about')} class="footer-link">{t.footer.about}</a></li>
        <li><a href={localePath(locale, '/faq')} class="footer-link">{t.footer.faq}</a></li>
        <li><a href={localePath(locale, '/terms')} class="footer-link">{t.footer.terms}</a></li>
        <li><a href={contact} class="footer-link">{t.footer.contact}</a></li>
      </ul>
    </div>
  </div>
</footer>
