---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import FaqItem from './FaqItem.astro';
import { siteConfig } from '../config/site';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath } from '../i18n';
import { splitTitleAccent } from '../lib/rich-text';
import { faqPageSchema, breadcrumbSchema } from '../lib/seo-schemas';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const faqUrl = new URL(localePath(locale, '/faq'), siteConfig.url).href;
const homeUrl = new URL(localePath(locale, '/'), siteConfig.url).href;
---

<Layout
  locale={locale}
  title={t.faqPage.pageTitle}
  description={t.faqPage.pageSubtitle}
  jsonLd={[
    faqPageSchema(t.faqPage.items),
    breadcrumbSchema([
      { name: t.a11y.home, url: homeUrl },
      { name: t.faqPage.pageTitle, url: faqUrl },
    ]),
  ]}
>
  <PageHero locale={locale} badge={t.faqPage.badge} {...splitTitleAccent(t.faqPage.pageTitle)} subtitle={t.faqPage.pageSubtitle}>
    <a slot="aside" href={localePath(locale, '/#contact')} class="sh-link">{t.termsPage.helpContact}</a>
  </PageHero>

  <section class="home-section page-first">
    <div class="home-wrap">
      <div class="faq-list">
        {t.faqPage.items.map((item, index) => <FaqItem locale={locale} number={index + 1} q={item.q} a={item.a} as="h2" open={index === 0} />)}
      </div>
    </div>
  </section>
</Layout>
