---
import SectionHeader from './SectionHeader.astro';
import PackageCard from './PackageCard.astro';
import PanelLink from './PanelLink.astro';
import type { Locale } from '../i18n/types';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section id="packages-overview" class="section-spacing relative overflow-hidden">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="chart-pattern absolute inset-0 opacity-20" aria-hidden="true"></div>
    <div class="relative text-center">
      <SectionHeader
        badge={t.packages.badge}
        title={t.packages.title}
        titleAccent={t.packages.titleAccent}
        subtitle={t.packages.subtitle}
        align="center"
      />
    </div>

    <div class="section-body-gap relative grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {t.packages.items.map((pkg) => <PackageCard locale={locale} pkg={pkg} />)}
    </div>

    <p class="relative mt-6 text-center text-xs text-subtle">{t.packages.disclaimer}</p>
    <div class="relative mt-8 flex justify-center">
      <PanelLink locale={locale} showArrow class="min-w-[220px] justify-center font-semibold">
        {t.packages.cta}
      </PanelLink>
    </div>
  </div>
</section>
