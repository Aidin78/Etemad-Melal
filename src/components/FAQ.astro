---
import SectionBadge from './SectionBadge.astro';

const faqs = [
  {
    q: 'چگونه در اعتماد ملل ثبت‌نام کنم؟',
    a: 'روی دکمه «شروع» یا «ورود» بزنید و فرآیند ثبت‌نام را در پنل تکمیل نمایید. پس از احراز هویت می‌توانید پکیج سرمایه‌گذاری انتخاب کنید.',
  },
  {
    q: 'مسیرهای درآمد در اعتماد ملل کدام‌اند؟',
    a: 'سه نوع پاداش اصلی در پنل ثبت می‌شود: سود مشارکت ماهانه، حق مشارکت مستقیم و توسعه مشارکتی (تعادل). هر کدام در گزارش کمیسیون‌ها و داشبورد مالی جداگانه نمایش داده می‌شود.',
  },
  {
    q: 'حداقل مبلغ سرمایه‌گذاری چقدر است؟',
    a: 'با پکیج آغازه از ۱۰ میلیون تومان می‌توانید شروع کنید. سقف و درصد سود هر پکیج در صفحه «پکیج‌ها» مشخص است.',
  },
  {
    q: 'چگونه سود و وضعیت حساب را پیگیری کنم؟',
    a: 'در پنل: داشبورد مالی، برنامه سود ماهانه، کمیسیون‌ها و تراکنش‌های کیف پول. همه به‌صورت لحظه‌ای به‌روز می‌شوند.',
  },
  {
    q: 'آیا امکان برداشت وجود دارد؟',
    a: 'بله. درخواست برداشت از پنل ثبت می‌شود و پس از تأیید پردازش می‌گردد. وضعیت در لیست تراکنش‌ها قابل مشاهده است.',
  },
  {
    q: 'چگونه با پشتیبانی تماس بگیرم؟',
    a: 'از فرم تماس در همین صفحه (ایمیل) یا تیکت داخل پنل کاربری. شماره تلفن برای پشتیبانی عمومی در وب‌سایت منتشر نمی‌شود.',
  },
];
---

<section id="faq" class="section-spacing bg-secondary/30">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="text-center">
      <SectionBadge label="پرسش‌های متداول" />
      <h2 class="section-title">سوالات <span class="section-title-accent">متداول</span></h2>
      <p class="section-subtitle mx-auto">پاسخ پرسش‌های رایج درباره پلتفرم و نحوه سرمایه‌گذاری.</p>
    </div>

    <div class="mt-8 space-y-3 sm:mt-12 sm:space-y-4">
      {
        faqs.map((item) => (
          <details class="investment-card group rounded-xl transition">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-sm font-bold text-white [&::-webkit-details-marker]:hidden">
              <span class="flex items-center gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent-gold/15 text-xs text-accent-gold">؟</span>
                {item.q}
              </span>
              <span class="shrink-0 text-accent-gold transition group-open:rotate-180">▼</span>
            </summary>
            <p class="border-t border-white/5 px-5 py-5 text-sm leading-relaxed text-zinc-400">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
