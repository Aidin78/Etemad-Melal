---
import SectionBadge from './SectionBadge.astro';
import { siteFaqs } from '../config/faqs';
---

<section id="faq" class="section-spacing bg-secondary/30">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="text-center">
      <SectionBadge label="پرسش‌های متداول" />
      <h2 class="section-title">سوالات <span class="section-title-accent">متداول</span></h2>
      <p class="section-subtitle mx-auto">پاسخ پرسش‌های رایج درباره پلتفرم و نحوه سرمایه‌گذاری.</p>
    </div>

    <div class="mt-8 space-y-3 sm:mt-12 sm:space-y-4">
      {
        siteFaqs.map((item) => (
          <details class="investment-card group rounded-xl transition">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-sm font-bold text-white [&::-webkit-details-marker]:hidden">
              <span class="flex items-center gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent-gold/15 text-xs text-accent-gold">؟</span>
                {item.q}
              </span>
              <span class="shrink-0 text-accent-gold transition group-open:rotate-180">▼</span>
            </summary>
            <p class="border-t border-white/5 px-5 py-5 text-sm leading-relaxed text-zinc-400">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
