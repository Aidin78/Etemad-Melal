---
import FaqItem from './FaqItem.astro';
import HomeSectionHead from './HomeSectionHead.astro';
import OrbitMark from './OrbitMark.astro';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath } from '../i18n';
import { homepageFaqCount } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const items = t.faqPage.items.slice(0, homepageFaqCount);
---

<section id="faq" class="home-section band-dark" data-pointer>
  <OrbitMark class="orbit-mark--faq" />
  <div class="home-wrap faq-grid">
    <HomeSectionHead
      locale={locale}
      index={6}
      badge={t.faq.badge}
      title={t.faq.title}
      titleAccent={t.faq.titleAccent}
      subtitle={t.faq.subtitle}
      stacked
    >
      <a slot="aside" href={localePath(locale, '/faq')} class="sh-link sh-link--all">{t.faq.viewAllLabel}</a>
    </HomeSectionHead>

    <div class="faq-list">
      {items.map((item, index) => <FaqItem locale={locale} number={index + 1} q={item.q} a={item.a} name="home-faq" open={index === 0} />)}
    </div>
  </div>
</section>
