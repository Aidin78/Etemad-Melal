---
import HomeSectionHead from './HomeSectionHead.astro';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath, formatBoxIndex } from '../i18n';
import { homepageFaqCount } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const items = t.faqPage.items.slice(0, homepageFaqCount);
---

<section id="faq" class="home-section">
  <div class="home-wrap">
    <HomeSectionHead
      locale={locale}
      index={6}
      badge={t.faq.badge}
      title={t.faq.title}
      titleAccent={t.faq.titleAccent}
      subtitle={t.faq.subtitle}
    >
      <a slot="aside" href={localePath(locale, '/faq')} class="sh-link">{t.faq.viewAllLabel}</a>
    </HomeSectionHead>

    <div class="faq-list">
      {
        items.map((item, index) => (
          <details class="faq-item" data-reveal>
            <summary class="faq-summary">
              <span class="faq-num" aria-hidden="true">{formatBoxIndex(index + 1, locale)}</span>
              <h3 class="faq-q">{item.q}</h3>
              <span class="faq-toggle" aria-hidden="true"></span>
            </summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
