---
import SectionHeader from './SectionHeader.astro';
import type { Locale } from '../i18n/types';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const faqIcon = locale === 'fa' ? '؟' : '?';
---

<section id="faq" class="section-spacing bg-section-alt">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <SectionHeader
      badge={t.faq.badge}
      title={t.faq.title}
      titleAccent={t.faq.titleAccent}
      subtitle={t.faq.subtitle}
      align="center"
    />

    <div class="mt-8 space-y-3 sm:mt-12 sm:space-y-4">
      {
        t.faq.items.map((item) => (
          <details class="investment-card group rounded-xl transition">
            <summary class="flex min-h-[3.25rem] cursor-pointer list-none items-center justify-between gap-4 p-5 text-sm font-bold text-heading [&::-webkit-details-marker]:hidden">
              <span class="flex items-center gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent-gold/15 text-xs text-accent-gold">{faqIcon}</span>
                {item.q}
              </span>
              <span class="shrink-0 text-accent-gold transition group-open:rotate-180">▼</span>
            </summary>
            <p class="border-t border-divider px-5 py-5 text-sm leading-relaxed text-muted">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
