---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import PanelLink from './PanelLink.astro';
import type { Locale } from '../i18n/types';
import { formatBoxIndex, getTranslations, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const localizedHref = (href: string) => localePath(locale, href);
const isHome = Astro.url.pathname.replace(/\/$/, '') === localizedHref('/').replace(/\/$/, '');

/** Only standalone pages receive an active navigation state. */
const navDataAttrs = (href: string) => href.includes('#') ? {} : { 'data-nav-path': localizedHref(href) };
---

<header class="site-header fixed inset-x-0 top-0 z-50" id="site-header">
  <div class="site-header-bar">
    <Logo locale={locale} size="sm" animated={false} class="min-w-0 shrink" />

    <nav class="site-nav hidden lg:block" aria-label={t.a11y.mainNav}>
      <ul class="site-nav-list">
        {
          t.nav.map((item) =>
            item.children?.length ? (
              <li class="nav-item nav-item--sub">
                <a href={localizedHref(item.href)} class="nav-link" aria-haspopup="true">
                  {item.label}
                  <svg class="nav-caret" viewBox="0 0 12 12" fill="none" stroke="currentColor" aria-hidden="true">
                    <path d="M3 4.5l3 3 3-3" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                <div class="nav-sub">
                  <ul class="nav-sub-list">
                    {item.children.map((child) => (
                      <li>
                        <a href={localizedHref(child.href)} class="nav-sub-link" {...navDataAttrs(child.href)}>
                          <strong>{child.label}</strong>
                          {child.desc && <small>{child.desc}</small>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </li>
            ) : (
              <li class="nav-item">
                <a href={localizedHref(item.href)} class="nav-link" {...navDataAttrs(item.href)}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="site-header-tools">
      <div class="site-header-prefs hidden lg:flex">
        <LanguageSwitcher locale={locale} compact />
        <ThemeToggle ariaLabel={t.a11y.themeToggle} labelLight={t.a11y.switchToLight} labelDark={t.a11y.switchToDark} />
      </div>
      <PanelLink locale={locale} class="site-header-cta max-lg:!hidden">{t.panelCtaLogin}</PanelLink>
      <button
        type="button"
        class="mobile-menu-toggle flex h-11 w-11 items-center justify-center lg:hidden"
        id="menu-toggle"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 8h16M4 16h16" />
        </svg>
      </button>
    </div>
  </div>
</header>
<script is:inline define:vars={{ isHome }}>
  // Set before first paint so the bar never flashes its unscrolled shape (or, on the homepage, a solid surface over the hero)
  var header = document.getElementById('site-header');
  header.classList.toggle('is-scrolled', window.scrollY > 24);
  if (isHome) header.classList.toggle('is-top', window.scrollY < 8);
</script>

<div class="mobile-menu lg:hidden" id="mobile-menu" inert>
  <button type="button" class="mobile-menu-backdrop" id="mobile-menu-backdrop" aria-label={t.a11y.closeMenu} tabindex="-1"></button>
  <div class="mobile-menu-panel" role="dialog" aria-modal="true" aria-label={t.a11y.mobileNav}>
    <div class="mobile-menu-head">
      <Logo locale={locale} size="sm" animated={false} class="min-w-0 shrink" />
      <button type="button" class="mobile-menu-close" id="mobile-menu-close" aria-label={t.a11y.closeMenu}>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="mobile-menu-nav" aria-label={t.a11y.mobileNav}>
      {
        t.nav.map((item, i) => (
          <div class="nav-mobile-group" style={`--i: ${i}`}>
            <a
              href={localizedHref(item.href)}
              class="nav-link-mobile"
              {...(item.children?.length ? {} : navDataAttrs(item.href))}
            >
              <span class="nav-link-mobile-num" aria-hidden="true">{formatBoxIndex(i + 1, locale)}</span>
              {item.label}
            </a>
            {item.children?.length && (
              <ul class="nav-mobile-sub">
                {item.children.map((child) => (
                  <li>
                    <a href={localizedHref(child.href)} class="nav-sub-link-mobile" {...navDataAttrs(child.href)}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </nav>

    <div class="mobile-menu-footer">
      <div class="mobile-menu-pref">
        <span>{t.langSwitch.label}</span>
        <LanguageSwitcher locale={locale} />
      </div>
      <div class="mobile-menu-pref">
        <span>{t.a11y.themeLabel}</span>
        <ThemeToggle ariaLabel={t.a11y.themeToggle} labelLight={t.a11y.switchToLight} labelDark={t.a11y.switchToDark} />
      </div>
      <PanelLink locale={locale} class="mobile-menu-cta w-full justify-center">{t.panelCtaLogin}</PanelLink>
    </div>
  </div>
</div>
