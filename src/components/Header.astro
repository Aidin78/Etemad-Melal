---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import PanelLink from './PanelLink.astro';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const sectionId = (href: string) => (href.includes('#') ? href.split('#')[1] : null);

const navDataAttrs = (href: string) => {
  const id = sectionId(href);
  if (id) return { 'data-nav-section': id };
  const articlesPath = localePath(locale, '/articles');
  if (href === '/articles' || href.startsWith('/articles')) {
    return { 'data-nav-path': articlesPath };
  }
  const aboutPath = localePath(locale, '/about');
  if (href === '/about' || href.startsWith('/about')) {
    return { 'data-nav-path': aboutPath };
  }
  return {};
};

const localizedHref = (href: string) => localePath(locale, href);
---

<header class="site-header fixed inset-x-0 top-0 z-50 border-b border-theme bg-header backdrop-blur-xl" id="site-header">
  <div class="site-header-bar mx-auto flex max-w-6xl items-center justify-between gap-2 px-3 sm:gap-4 sm:px-6">
    <Logo locale={locale} size="sm" animated={false} class="min-w-0 shrink" />

    <nav class="hidden items-center gap-6 lg:flex" aria-label={t.a11y.mainNav}>
      {
        t.nav.map((link) => (
          <a href={localizedHref(link.href)} class="nav-link" {...navDataAttrs(link.href)}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-2 lg:gap-3">
      <div class="hidden items-center gap-1.5 sm:flex sm:gap-2">
        <LanguageSwitcher locale={locale} />
        <ThemeToggle ariaLabel={t.a11y.themeToggle} />
      </div>
      <PanelLink locale={locale} class="max-lg:!hidden text-sm !px-5 !py-2.5">{t.panelCtaLogin}</PanelLink>
      <button
        type="button"
        class="mobile-menu-toggle flex h-11 w-11 items-center justify-center rounded-lg border border-theme bg-[var(--toggle-bg)] text-[var(--toggle-text)] transition-colors duration-300 lg:hidden"
        id="menu-toggle"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" id="icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="hidden h-5 w-5" id="icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu lg:hidden" id="mobile-menu" hidden>
    <button type="button" class="mobile-menu-backdrop" id="mobile-menu-backdrop" aria-label={t.a11y.closeMenu} tabindex="-1"></button>
    <div class="mobile-menu-panel border-t border-theme bg-header-mobile shadow-[0_24px_48px_rgb(0_0_0/0.18)]">
      <nav class="mobile-menu-nav" aria-label={t.a11y.mobileNav}>
        {
          t.nav.map((link) => (
            <a href={localizedHref(link.href)} class="nav-link-mobile" {...navDataAttrs(link.href)}>
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="mobile-menu-footer border-t border-theme px-4 py-4">
        <div class="flex items-center justify-between gap-3 sm:hidden">
          <LanguageSwitcher locale={locale} />
          <ThemeToggle ariaLabel={t.a11y.themeToggle} />
        </div>
        <PanelLink locale={locale} class="mobile-menu-cta mt-3 w-full justify-center text-sm sm:mt-0">{t.panelCtaLogin}</PanelLink>
      </div>
    </div>
  </div>
</header>

<script define:vars={{ openLabel: t.a11y.openMenu, closeLabel: t.a11y.closeMenu }}>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const header = document.getElementById('site-header');

  const setMenuOpen = (open) => {
    menu?.classList.toggle('mobile-menu--open', open);
    menu?.toggleAttribute('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? closeLabel : openLabel);
    toggle?.classList.toggle('mobile-menu-toggle--open', open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    document.body.classList.toggle('mobile-menu-open', open);
  };

  toggle?.addEventListener('click', () => {
    setMenuOpen(!menu?.classList.contains('mobile-menu--open'));
  });

  backdrop?.addEventListener('click', () => setMenuOpen(false));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.classList.contains('mobile-menu--open')) {
      setMenuOpen(false);
    }
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches) setMenuOpen(false);
  });

  const normalizePath = () => {
    const path = window.location.pathname.replace(/\/$/, '');
    return path || '/';
  };

  const setLinkActive = (link, active) => {
    link.classList.toggle('nav-link-active', active);
    if (active) link.setAttribute('aria-current', 'page');
    else link.removeAttribute('aria-current');
  };

  const clearNavActive = () => {
    document.querySelectorAll('[data-nav-section], [data-nav-path]').forEach((link) => setLinkActive(link, false));
  };

  function initPageNav() {
    const path = normalizePath();
    document.querySelectorAll('[data-nav-path]').forEach((link) => {
      const prefix = link.dataset.navPath;
      setLinkActive(link, !!prefix && path.startsWith(prefix));
    });
  }

  function initScrollSpy() {
    const links = document.querySelectorAll('[data-nav-section]');
    if (!links.length) return;

    const sections = [...links]
      .map((link) => {
        const id = link.dataset.navSection;
        return id ? document.getElementById(id) : null;
      })
      .filter((el) => !!el);

    if (!sections.length) return;

    const scrollOffset = () => (header?.offsetHeight ?? 56) + 40;

    const setActive = (id) => {
      clearNavActive();
      links.forEach((link) => setLinkActive(link, link.dataset.navSection === id));
    };

    const update = () => {
      const line = scrollOffset();
      let current = sections[0].id;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= line) current = section.id;
      }
      setActive(current);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    links.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.dataset.navSection;
        if (id) setActive(id);
      });
    });

    const hash = window.location.hash.slice(1);
    if (hash && document.getElementById(hash)) setActive(hash);
    else update();
  }

  const path = normalizePath();
  if (path.includes('/articles') || path.includes('/about')) initPageNav();
  else if (path === '/' || path === '/en') initScrollSpy();
</script>
