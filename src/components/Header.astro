---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import PanelLink from './PanelLink.astro';
import type { Locale } from '../i18n/types';
import { formatBoxIndex, getTranslations, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const localizedHref = (href: string) => localePath(locale, href);
const primaryNav = t.nav.filter((link) => !link.secondary);
const isHome = Astro.url.pathname.replace(/\/$/, '') === localizedHref('/').replace(/\/$/, '');

/** Hooks for src/scripts/header.ts: homepage sections get a scroll-spy, pages a path match */
const navDataAttrs = (href: string) => {
  const section = href.split('#')[1];
  return section ? { 'data-nav-section': section } : { 'data-nav-path': localizedHref(href) };
};
---

<header class="site-header fixed inset-x-0 top-0 z-50 bg-header backdrop-blur-xl" id="site-header">
  <div class="site-header-bar">
    <Logo locale={locale} size="sm" animated={false} class="min-w-0 shrink" />

    <nav class="site-nav hidden lg:flex" aria-label={t.a11y.mainNav}>
      {
        primaryNav.map((link) => (
          <a href={localizedHref(link.href)} class="nav-link" {...navDataAttrs(link.href)}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header-tools">
      <div class="site-header-prefs hidden lg:flex">
        <LanguageSwitcher locale={locale} compact />
        <ThemeToggle ariaLabel={t.a11y.themeToggle} labelLight={t.a11y.switchToLight} labelDark={t.a11y.switchToDark} />
      </div>
      <PanelLink locale={locale} class="site-header-cta max-lg:!hidden">{t.panelCtaLogin}</PanelLink>
      <button
        type="button"
        class="mobile-menu-toggle flex h-11 w-11 items-center justify-center lg:hidden"
        id="menu-toggle"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 8h16M4 16h16" />
        </svg>
      </button>
    </div>
  </div>
</header>
{
  isHome && (
    <script is:inline>
      // Set before first paint so the homepage header never flashes solid over the hero
      document.getElementById('site-header').classList.toggle('is-top', window.scrollY < 8);
    </script>
  )
}

<div class="mobile-menu lg:hidden" id="mobile-menu">
  <button type="button" class="mobile-menu-backdrop" id="mobile-menu-backdrop" aria-label={t.a11y.closeMenu} tabindex="-1"></button>
  <div class="mobile-menu-panel" role="dialog" aria-modal="true" aria-label={t.a11y.mobileNav}>
    <div class="mobile-menu-head">
      <Logo locale={locale} size="sm" animated={false} class="min-w-0 shrink" />
      <button type="button" class="mobile-menu-close" id="mobile-menu-close" aria-label={t.a11y.closeMenu}>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="mobile-menu-nav" aria-label={t.a11y.mobileNav}>
      {
        t.nav.map((link, i) => (
          <a href={localizedHref(link.href)} class="nav-link-mobile" style={`--i: ${i}`} {...navDataAttrs(link.href)}>
            <span class="nav-link-mobile-num" aria-hidden="true">{formatBoxIndex(i + 1, locale)}</span>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="mobile-menu-footer">
      <div class="mobile-menu-pref">
        <span>{t.langSwitch.label}</span>
        <LanguageSwitcher locale={locale} />
      </div>
      <div class="mobile-menu-pref">
        <span>{t.a11y.themeLabel}</span>
        <ThemeToggle ariaLabel={t.a11y.themeToggle} labelLight={t.a11y.switchToLight} labelDark={t.a11y.switchToDark} />
      </div>
      <PanelLink locale={locale} class="mobile-menu-cta w-full justify-center">{t.panelCtaLogin}</PanelLink>
    </div>
  </div>
</div>
