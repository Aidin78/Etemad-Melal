---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import PanelLink from './PanelLink.astro';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const sectionId = (href: string) => (href.includes('#') ? href.split('#')[1] : null);

const navDataAttrs = (href: string) => {
  const id = sectionId(href);
  if (id) return { 'data-nav-section': id };
  const articlesPath = localePath(locale, '/articles');
  if (href === '/articles' || href.startsWith('/articles')) {
    return { 'data-nav-path': articlesPath };
  }
  const aboutPath = localePath(locale, '/about');
  if (href === '/about' || href.startsWith('/about')) {
    return { 'data-nav-path': aboutPath };
  }
  return {};
};

const localizedHref = (href: string) => localePath(locale, href);
const primaryNav = t.nav.filter((link) => !link.secondary);
---

<header class="site-header fixed inset-x-0 top-0 z-50 bg-header backdrop-blur-xl" id="site-header">
  <div class="site-header-bar">
    <Logo locale={locale} size="sm" animated={false} class="min-w-0 shrink" />

    <nav class="site-nav hidden lg:flex" aria-label={t.a11y.mainNav}>
      {
        primaryNav.map((link) => (
          <a href={localizedHref(link.href)} class="nav-link" {...navDataAttrs(link.href)}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header-tools">
      <div class="hidden items-center gap-1 sm:flex">
        <LanguageSwitcher locale={locale} compact />
        <ThemeToggle ariaLabel={t.a11y.themeToggle} labelLight={t.a11y.switchToLight} labelDark={t.a11y.switchToDark} />
      </div>
      <PanelLink locale={locale} class="site-header-cta max-lg:!hidden">{t.panelCtaLogin}</PanelLink>
      <button
        type="button"
        class="mobile-menu-toggle flex h-11 w-11 items-center justify-center lg:hidden"
        id="menu-toggle"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" id="icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 8h16M4 16h16" />
        </svg>
        <svg class="hidden h-5 w-5" id="icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu lg:hidden" id="mobile-menu" hidden>
  <button type="button" class="mobile-menu-backdrop" id="mobile-menu-backdrop" aria-label={t.a11y.closeMenu} tabindex="-1"></button>
  <div class="mobile-menu-panel border-t border-theme bg-header-mobile shadow-[0_24px_48px_rgb(0_0_0/0.18)]">
    <nav class="mobile-menu-nav" aria-label={t.a11y.mobileNav}>
      {
        t.nav.map((link) => (
          <a href={localizedHref(link.href)} class="nav-link-mobile" {...navDataAttrs(link.href)}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="mobile-menu-footer border-t border-theme px-4 py-4">
      <div class="flex items-center justify-between gap-3 sm:hidden">
        <LanguageSwitcher locale={locale} />
        <ThemeToggle ariaLabel={t.a11y.themeToggle} labelLight={t.a11y.switchToLight} labelDark={t.a11y.switchToDark} />
      </div>
      <PanelLink locale={locale} class="mobile-menu-cta mt-3 w-full justify-center text-sm sm:mt-0">{t.panelCtaLogin}</PanelLink>
    </div>
  </div>
</div>

<script define:vars={{ openLabel: t.a11y.openMenu, closeLabel: t.a11y.closeMenu }}>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('mobile-menu-backdrop');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const header = document.getElementById('site-header');

  const main = document.getElementById('main-content');
  const footer = document.querySelector('footer');
  const focusableSelector =
    'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])';

  const setMenuOpen = (open) => {
    menu?.classList.toggle('mobile-menu--open', open);
    menu?.toggleAttribute('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? closeLabel : openLabel);
    toggle?.classList.toggle('mobile-menu-toggle--open', open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    document.body.classList.toggle('mobile-menu-open', open);

    if (open) {
      main?.setAttribute('inert', '');
      footer?.setAttribute('inert', '');
      const firstLink = menu?.querySelector('a');
      firstLink?.focus();
    } else {
      main?.removeAttribute('inert');
      footer?.removeAttribute('inert');
    }
  };

  toggle?.addEventListener('click', () => {
    const opening = !menu?.classList.contains('mobile-menu--open');
    setMenuOpen(opening);
    if (!opening) toggle.focus();
  });

  backdrop?.addEventListener('click', () => {
    setMenuOpen(false);
    toggle?.focus();
  });

  document.addEventListener('keydown', (event) => {
    if (!menu?.classList.contains('mobile-menu--open')) return;

    if (event.key === 'Escape') {
      setMenuOpen(false);
      toggle?.focus();
      return;
    }

    if (event.key === 'Tab') {
      const focusable = [...menu.querySelectorAll(focusableSelector)].filter(
        (el) => el.offsetParent !== null,
      );
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches) setMenuOpen(false);
  });

  const normalizePath = () => {
    const path = window.location.pathname.replace(/\/$/, '');
    return path || '/';
  };

  const setLinkActive = (link, active, currentValue = 'page') => {
    link.classList.toggle('nav-link-active', active);
    if (active) link.setAttribute('aria-current', currentValue);
    else link.removeAttribute('aria-current');
  };

  const clearNavActive = () => {
    document
      .querySelectorAll('[data-nav-section]')
      .forEach((link) => setLinkActive(link, false, 'location'));
  };

  function initPageNav() {
    const path = normalizePath();
    document.querySelectorAll('[data-nav-path]').forEach((link) => {
      const prefix = link.dataset.navPath;
      setLinkActive(link, !!prefix && path.startsWith(prefix), 'page');
    });
  }

  function initScrollSpy() {
    const links = document.querySelectorAll('[data-nav-section]');
    if (!links.length) return;

    const sections = [...links]
      .map((link) => {
        const id = link.dataset.navSection;
        return id ? document.getElementById(id) : null;
      })
      .filter((el) => !!el);

    if (!sections.length) return;

    const scrollOffset = () => (header?.offsetHeight ?? 56) + 40;

    const setActive = (id) => {
      clearNavActive();
      links.forEach((link) => setLinkActive(link, link.dataset.navSection === id, 'location'));
    };

    const update = () => {
      const line = scrollOffset();
      let current = sections[0].id;
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= line) current = section.id;
      }
      setActive(current);
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    links.forEach((link) => {
      link.addEventListener('click', () => {
        const id = link.dataset.navSection;
        if (id) setActive(id);
      });
    });

    const hash = window.location.hash.slice(1);
    if (hash && document.getElementById(hash)) setActive(hash);
    else update();
  }

  const path = normalizePath();
  const isHome = path === '/' || path === '/en';

  // Homepage: the header sits transparently on the hero until the page scrolls
  // (checked by path — this script runs before the page content is parsed)
  if (isHome) {
    const syncTop = () => header?.classList.toggle('is-top', window.scrollY < 8);
    syncTop();
    window.addEventListener('scroll', syncTop, { passive: true });
  }

  // Slides away while scrolling down, comes back on any scroll up (never while the menu is open)
  let lastY = window.scrollY;
  let hideTicking = false;
  const syncHidden = () => {
    hideTicking = false;
    const y = window.scrollY;
    const delta = y - lastY;
    if (Math.abs(delta) < 6) return;
    const menuOpen = menu?.classList.contains('mobile-menu--open');
    header?.classList.toggle('is-hidden', !menuOpen && delta > 0 && y > (header?.offsetHeight ?? 64));
    lastY = y;
  };
  window.addEventListener(
    'scroll',
    () => {
      if (hideTicking) return;
      hideTicking = true;
      requestAnimationFrame(syncHidden);
    },
    { passive: true },
  );

  if (path.includes('/articles') || path.includes('/about')) initPageNav();
  else if (isHome) initScrollSpy();
</script>
