---
import Icon from './Icon.astro';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className = 'h-4 w-4' } = Astro.props;
const arrowClass = locale === 'fa' ? `${className} rotate-180` : className;
---

<Icon class={arrowClass} strokeWidth={2} d="M17 8l4 4m0 0l-4 4m4-4H3" />
