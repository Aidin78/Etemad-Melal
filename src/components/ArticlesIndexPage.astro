---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import PageHero from '../components/PageHero.astro';
import { getSortedArticles } from '../lib/articles';
import type { Locale } from '../i18n/types';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const [lead, ...rest] = await getSortedArticles(locale);
---

<Layout
  locale={locale}
  title={t.news.pageTitle}
  description={t.news.pageSubtitle}
>
  <PageHero locale={locale} badge={t.news.badge} title={t.news.pageTitle} titleAccent={t.siteName} subtitle={t.news.pageSubtitle} />

  <section class="home-section page-first" data-pointer>
    <div class="home-wrap">
      {lead && <NewsCard locale={locale} post={lead} variant="feature" as="h2" data-reveal data-spotlight="spill" />}
      {
        rest.length > 0 && (
          <ul class="news-cards">
            {rest.map((post) => (
              <li data-reveal>
                <NewsCard locale={locale} post={post} as="h2" data-spotlight="spill" />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Layout>
