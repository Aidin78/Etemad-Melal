---
interface Props {
  content: string;
}

const { content } = Astro.props;
const paragraphs = content
  .trim()
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<div class="about-section-body space-y-4">
  {paragraphs.map((paragraph) => (
    <p class="text-sm leading-[1.85] text-muted sm:text-base">{paragraph}</p>
  ))}
</div>
