---
import { siteConfig } from '../config/site';
import { parsePanelLinks } from '../lib/rich-text';

interface Props {
  content: string;
}

const { content } = Astro.props;
const paragraphs = content
  .trim()
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<div class="page-body">
  {
    paragraphs.map((paragraph) => (
      <p>
        {
          parsePanelLinks(paragraph, siteConfig.panelUrl).map((part) =>
            part.type === 'link' ? (
              <a href={part.href} target="_blank" rel="noopener noreferrer">
                {part.label}
              </a>
            ) : (
              part.value
            ),
          )
        }
      </p>
    ))
  }
</div>
