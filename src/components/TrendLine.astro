---
/**
 * Decorative growth line: a rising, gently uneven trend over faint dashed gridlines, with a node
 * at each step up and a short pulse of light running along it once drawn — capital moving
 * through the investment. Purely visual (aria-hidden), styles in home.css (`.trend`).
 * It traces itself with the scroll (data-scrub="line": complete once the element's bottom
 * reaches the viewport bottom). Like every chart on the site it reads left → right in both locales.
 * Kept out of the hero on purpose: the first view already has enough motion.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
// Unique per instance: a page can carry several (sections + footer)
const fillId = `trend-fill-${Math.random().toString(36).slice(2, 8)}`;

const line =
  'M0 172 C 60 170, 100 150, 150 152 S 240 172, 300 140 S 380 116, 430 126 S 520 150, 580 110 S 680 82, 740 94 S 840 108, 900 70 S 1000 54, 1060 48 S 1150 28, 1200 16';
// Nodes on the steps up; `t` is roughly how far along the line each sits (0 → 1)
const nodes = [
  { x: 300, y: 140, t: 0.25 },
  { x: 580, y: 110, t: 0.49 },
  { x: 900, y: 70, t: 0.75 },
  { x: 1200, y: 16, t: 0.99 },
];
---

<div class:list={['trend', className]} aria-hidden="true" data-scrub="line" data-scrub-line="1">
  <svg viewBox="0 0 1200 200" preserveAspectRatio="none" fill="none">
    <defs>
      <linearGradient id={fillId} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="currentColor" stop-opacity="0.16" />
        <stop offset="1" stop-color="currentColor" stop-opacity="0" />
      </linearGradient>
    </defs>
    <g class="trend-grid">
      <line x1="0" y1="50" x2="1200" y2="50" />
      <line x1="0" y1="100" x2="1200" y2="100" />
      <line x1="0" y1="150" x2="1200" y2="150" />
    </g>
    <path class="trend-area" d={`${line} L1200 200 L0 200 Z`} fill={`url(#${fillId})`} />
    <path class="trend-line" d={line} pathLength="1" />
    <path class="trend-pulse" d={line} pathLength="1" />
  </svg>
  {
    nodes.map((n) => (
      <span class="trend-node" style={`left: ${(n.x / 12).toFixed(2)}%; top: ${(n.y / 2).toFixed(2)}%; --t: ${n.t}`} />
    ))
  }
</div>
