---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import HomeSectionHead from './HomeSectionHead.astro';
import Icon from './Icon.astro';
import OrbitMark from './OrbitMark.astro';
import Photo from './Photo.astro';
import AboutSectionContent from './AboutSectionContent.astro';
import PanelLink from './PanelLink.astro';
import { getEntry } from 'astro:content';
import type { Locale } from '../i18n/types';
import { formatBoxIndex, getTranslations, localePath } from '../i18n';
import { aboutValueIcons } from '../lib/section-icons';
import { splitTitleAccent } from '../lib/rich-text';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const entry = await getEntry('about', locale);

if (!entry) {
  throw new Error(`About page content not found for locale: ${locale}`);
}

const { data } = entry;
---

<Layout locale={locale} title={data.metaTitle} description={data.metaDescription} footerCta={false}>
  <div class="about-intro">
    <PageHero
      locale={locale}
      badge={t.about.badge}
      title={data.heroTitle}
      titleAccent={data.heroTitleAccent}
      subtitle={data.heroSubtitle}
    >
      <figure class="mt-10 lg:mt-14">
        <div class="page-photo" data-scrub>
          <Photo src={data.image} alt={data.imageAlt} loading="eager" fetchpriority="high" sizes="100vw" />
        </div>
        <figcaption class="page-caption">
          <strong>{t.companyLegal}</strong>
          <span>{t.tagline}</span>
        </figcaption>
      </figure>

      <dl class="manifesto-highlights" data-reveal="cascade">
        {
          data.highlights.map((item, i) => (
            <div>
              <dt>
                <span class="manifesto-highlight-num" aria-hidden="true">{formatBoxIndex(i + 1, locale)}</span>
                {item.label}
              </dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>
    </PageHero>
  </div>

  <section class="home-section">
    <div class="home-wrap">
      <HomeSectionHead
        locale={locale}
        index={1}
        title={t.aboutPage.detailsTitle}
        subtitle={t.aboutPage.detailsSubtitle}
      />

      <ol class="chapters">
        {
          data.sections.map((section, index) => (
            <li class="chapter" data-reveal>
              <div class="chapter-head">
                <span class="chapter-num" aria-hidden="true">{formatBoxIndex(index + 1, locale)}</span>
                <h3 class="chapter-title">{section.title}</h3>
              </div>
              <div>
                {section.headline && <p class="chapter-headline">{section.headline}</p>}
                <AboutSectionContent content={section.content} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="home-section band-dark" data-pointer>
    <OrbitMark class="orbit-mark--manifesto" />
    <div class="home-wrap">
      <HomeSectionHead locale={locale} index={2} {...splitTitleAccent(data.valuesTitle)} />

      <ul class="tgrid tgrid--four" data-spotlight>
        {
          data.values.map((value, i) => (
            <li class="tcell" data-reveal="fade">
              <div class="tcell-head">
                <span class="tcell-num" aria-hidden="true">{formatBoxIndex(i + 1, locale)}</span>
                <Icon class="tcell-icon" strokeWidth={1.25} d={aboutValueIcons[i] ?? aboutValueIcons[0]} />
              </div>
              <h3 class="tcell-title">{value.title}</h3>
              <p class="tcell-desc">{value.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="home-section">
    <div class="home-wrap">
      <div class="page-cta" data-reveal>
        <div>
          <h2 class="page-cta-title">{t.aboutPage.ctaTitle}</h2>
          <p class="page-cta-sub">{t.aboutPage.ctaSubtitle}</p>
        </div>
        <div class="page-cta-actions">
          <PanelLink locale={locale} signup>{t.about.ctaStart}</PanelLink>
          <a href={localePath(locale, '/#contact')} class="btn-outline">{t.about.ctaContact}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
