---
import Layout from '../layouts/Layout.astro';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath, toLocaleDigits } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<Layout locale={locale} title={t.notFound.pageTitle} description={t.notFound.pageSubtitle} noindex footerCta={false}>
  <section class="page-hero notfound">
    <div class="home-wrap">
      <div class="sh-rule" data-reveal="rule">
        <span class="sh-label">{t.notFound.badge}</span>
      </div>
      <div class="notfound-grid" data-reveal="cascade">
        <p class="notfound-code" aria-hidden="true">{toLocaleDigits(404, locale)}</p>
        <div>
          <h1 class="sh-title">{t.notFound.pageTitle}</h1>
          <p class="sh-sub">{t.notFound.pageSubtitle}</p>
          <div class="page-cta-actions">
            <a href={localePath(locale, '/')} class="btn-primary">{t.notFound.homeCta}</a>
            <a href={localePath(locale, '/articles')} class="btn-outline">{t.notFound.articlesCta}</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
