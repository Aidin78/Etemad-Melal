---
import Layout from '../layouts/Layout.astro';
import DocToc from './DocToc.astro';
import HomeSectionHead from './HomeSectionHead.astro';
import NewsCard from './NewsCard.astro';
import Photo from './Photo.astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/types';
import { getArticleDisplay, getTranslations, localePath } from '../i18n';
import { parseArticleId } from '../lib/article-utils';
import { getSortedArticles } from '../lib/articles';
import { articleSchema, breadcrumbSchema } from '../lib/seo-schemas';
import { pageUrl } from '../lib/urls';

interface Props {
  locale: Locale;
  post: CollectionEntry<'articles'>;
}

const { locale, post } = Astro.props;
const t = getTranslations(locale);
const { Content, headings } = await render(post);
const { slug } = parseArticleId(post.id);

const display = getArticleDisplay(locale, post.data);
const articleUrl = pageUrl(locale, `/articles/${slug}`);

const toc = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }));
const related = (await getSortedArticles(locale)).filter((p) => p.id !== post.id).slice(0, 3);
---

<Layout
  locale={locale}
  title={post.data.metaTitle ?? display.title}
  description={post.data.metaDescription ?? display.excerpt}
  image={post.data.image}
  ogType="article"
  publishedTime={post.data.date}
  jsonLd={[
    articleSchema(t, {
      title: display.title,
      description: display.excerpt,
      image: post.data.image,
      datePublished: post.data.date,
      url: articleUrl,
    }),
    breadcrumbSchema([
      { name: t.a11y.home, url: pageUrl(locale, '/') },
      { name: t.news.pageTitle, url: pageUrl(locale, '/articles') },
      { name: display.title, url: articleUrl },
    ]),
  ]}
>
  <article itemscope itemtype="https://schema.org/Article">
    <header class="page-hero page-hero--article">
      <div class="home-wrap">
        <div class="sh-rule" data-reveal="rule">
          <time class="sh-index" datetime={post.data.date.toISOString()} itemprop="datePublished">
            {display.dateLabel}
          </time>
          <nav aria-label={t.a11y.breadcrumb}>
            <a href={localePath(locale, '/articles')} class="sh-link">{t.news.backToArticles}</a>
          </nav>
        </div>
        <h1 class="sh-title" data-reveal="fade" itemprop="headline">{display.title}</h1>
        <p class="sh-sub" data-reveal="fade" itemprop="description">{display.excerpt}</p>
      </div>
    </header>

    <div class="home-wrap article-photo">
      <div class="page-photo" data-scrub>
        <Photo src={post.data.image} alt="" loading="eager" fetchpriority="high" sizes="100vw" />
      </div>
    </div>

    <div class="home-wrap doc-layout">
      {toc.length > 1 && <DocToc title={t.termsPage.tocTitle} items={toc} />}
      <div class="article-prose" itemprop="articleBody" dir={t.dir} lang={t.lang}>
        <Content />
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="home-section page-first" data-pointer>
        <div class="home-wrap">
          <HomeSectionHead locale={locale} title={t.news.title} titleAccent={t.news.titleAccent}>
            <a slot="aside" href={localePath(locale, '/articles')} class="sh-link">{t.news.viewAll}</a>
          </HomeSectionHead>
          <ul class="news-cards">
            {related.map((p) => (
              <li data-reveal>
                <NewsCard locale={locale} post={p} data-spotlight="spill" />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Layout>
