---
import { siteConfig } from '../config/site';
import BackgroundOrbs from './BackgroundOrbs.astro';
import type { Locale } from '../i18n/types';
import { getTranslations } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const arrowClass = locale === 'fa' ? 'rotate-180' : '';
---

<section
  class="hero-intro relative overflow-hidden mesh-gradient max-sm:flex max-sm:min-h-[calc(100dvh-4.5rem)] max-sm:flex-col max-sm:justify-center sm:min-h-[92vh]"
>
  <BackgroundOrbs variant="hero" />
  <div class="absolute inset-0 grid-pattern opacity-60" aria-hidden="true"></div>
  <div class="absolute inset-0" aria-hidden="true">
    <img src="/images/hero.jpg" alt="" class="hero-img h-full w-full object-cover" loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-image-overlay-bottom"></div>
  </div>

  <div class="relative mx-auto flex w-full max-w-6xl flex-col items-center justify-center px-4 py-6 text-center sm:px-6 sm:py-0 sm:pb-24 sm:pt-28">
    <span class="reveal section-badge mb-4 sm:mb-6">
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"></span>
      {t.hero.badge}
    </span>

    <h1 class="reveal mx-auto max-w-4xl text-3xl font-bold leading-tight text-heading sm:mb-0 sm:text-5xl lg:text-6xl" style="animation-delay: 0.1s">
      {t.hero.title}
      <span class="section-title-accent">
        {t.hero.titleAccent}
      </span>
    </h1>

    <p class="reveal mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-body sm:mt-6 sm:text-lg" style="animation-delay: 0.2s">
      {t.hero.subtitle}
    </p>

    <div class="reveal mt-6 flex w-full flex-wrap items-center justify-center gap-3 sm:mt-10 sm:gap-4" style="animation-delay: 0.3s">
      <a href={siteConfig.panelUrl} class="btn-primary">
        {t.panelCtaStart}
        <svg class:list={['h-4 w-4', arrowClass]} fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a href="#features" class="btn-outline">{t.hero.learnMore}</a>
    </div>

    <div class="reveal mt-6 grid w-full max-w-3xl grid-cols-3 gap-2 sm:mt-16 sm:gap-8" style="animation-delay: 0.4s">
      {
        t.hero.stats.map((s) => (
          <div class="investment-card rounded-xl p-3 text-center sm:rounded-2xl sm:p-6">
            <p class="stat-value text-xl sm:text-3xl">{s.value}</p>
            <p class="mt-0.5 text-[10px] text-muted sm:mt-1 sm:text-sm">{s.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
