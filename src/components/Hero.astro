---
import { siteImages } from '../config/images';
import PanelLink from './PanelLink.astro';
import LogoIcon from './LogoIcon.astro';
import OrbitMark from './OrbitMark.astro';
import type { Locale } from '../i18n/types';
import { getTranslations, toLocaleDigits } from '../i18n';
import { getYearsActive } from '../lib/dates';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const p = t.hero.panel;
const yearsActive = toLocaleDigits(getYearsActive(), locale);

const titleWords = t.hero.title.trim().split(/\s+/);
const accentWords = t.hero.titleAccent.trim().split(/\s+/);
const accentPhrases = [t.hero.titleAccent, ...t.hero.titleRotate];

// Panel preview chart (viewBox 400 × 120, rising left → right) — illustrative, no figures
const line = 'M0 104 L40 98 L80 102 L120 84 L160 88 L200 70 L240 75 L280 52 L320 57 L360 32 L392 24';

// Ring split between the income streams (decorative shares of a 100-unit circumference, 2-unit gaps)
const ringShares = [60, 36];
let ringStart = 0;
const ringSegments = t.income.streams.map((stream, i) => {
  const length = ringShares[i] ?? 0;
  const seg = { color: stream.color, length, offset: -ringStart };
  ringStart += length + 2;
  return seg;
});
---

<section class="hero" data-scrub="exit" data-stack data-pointer>
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-wrap hero-grid">
    <div class="hero-copy">
      <p class="hero-eyebrow hero-enter">{t.hero.badge}</p>

      <h1 class="hero-title">
        {titleWords.map((word, i) => (
          <>
            <span class="mask-word"><span style={`--w: ${i}`}>{word}</span></span>{' '}
          </>
        ))}
        <span class="hero-title-accent">
          <span class="sr-only">{t.hero.titleAccent}</span>
          <span class="hero-type" aria-hidden="true" data-typewriter={JSON.stringify(accentPhrases)}>
            {accentWords.map((word, i) => (
              <>
                <span class="mask-word"><span style={`--w: ${titleWords.length + i}`}>{word}</span></span>{' '}
              </>
            ))}
          </span>
        </span>
      </h1>

      <p class="hero-subtitle hero-enter" style="--d: 0.5s">{t.hero.subtitle}</p>

      <div class="hero-actions hero-enter" style="--d: 0.6s">
        <PanelLink locale={locale} showArrow signup class="justify-center">
          {t.panelCtaStart}
        </PanelLink>
        <a href="#features" class="hero-link">{t.hero.learnMore}</a>
      </div>

      <dl class="hero-stats hero-enter" style="--d: 0.75s">
        {t.hero.stats.map((s) => (
          <div class="hero-stat">
            <dt>{s.label}</dt>
            <dd data-count>{s.value.replace('{years}', yearsActive)}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-orbit">
        <span></span>
        <OrbitMark class="hero-orbit-mark" />
      </div>

      <div class="hero-photo" data-scrub>
        <img src={siteImages.hero} alt="" loading="eager" fetchpriority="high" />
      </div>

      <div class="hero-panel">
        <div class="hero-panel-bar">
          <span class="hero-panel-name">
            <LogoIcon alt="" size="sm" class="hero-panel-logo" />
            {p.title}
          </span>
          <span class="hero-panel-live"><i></i>{p.live}</span>
        </div>

        <div class="hero-panel-mix">
          <svg class="hero-panel-ring" viewBox="0 0 42 42">
            <circle class="hero-panel-ring-track" cx="21" cy="21" r="15.915" />
            {ringSegments.map((seg) => (
              <circle
                cx="21"
                cy="21"
                r="15.915"
                stroke={seg.color}
                stroke-dasharray={`${seg.length} ${100 - seg.length}`}
                stroke-dashoffset={seg.offset}
              />
            ))}
          </svg>
          <div>
            <span class="hero-panel-label">{p.mix}</span>
            <ul class="hero-panel-streams">
              {t.income.streams.map((stream) => (
                <li><i style={`background: ${stream.color}`}></i>{stream.title}</li>
              ))}
            </ul>
          </div>
        </div>

        <div class="hero-panel-chart">
          <span class="hero-panel-label">{p.chartLabel}</span>
          <div class="hero-panel-plot">
            <svg viewBox="0 0 400 120" fill="none" preserveAspectRatio="none">
              <line x1="0" y1="30" x2="400" y2="30" />
              <line x1="0" y1="60" x2="400" y2="60" />
              <line x1="0" y1="90" x2="400" y2="90" />
              <path class="hero-panel-area" d={`${line} L400 120 L0 120 Z`} />
              <path class="hero-panel-line" d={line} pathLength="1" />
            </svg>
            <span class="hero-panel-dot"></span>
          </div>
        </div>

        <ul class="hero-panel-status">
          {p.status.map((s) => (
            <li><i></i>{s}</li>
          ))}
        </ul>
      </div>

      <div class="hero-chip">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
        </svg>
        {p.badge}
      </div>

      <div class="hero-notice">
        <span class="hero-notice-icon">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.5 12.75l6 6 9-13.5" />
          </svg>
        </span>
        <span>
          <strong>{p.notice}</strong>
          <small>{p.noticeSub}</small>
        </span>
      </div>
    </div>
  </div>

  <!-- Inside the section: a stacked section must be directly followed by the one that covers it -->
  <script>
    // Hero accent: once the intro has risen in, types out each phrase in turn, then erases it.
    // Screen readers keep the static sr-only copy; reduced motion keeps the first phrase.
    const TYPE_MS = 65;
    const ERASE_MS = 32;
    const HOLD_MS = 2400;
    const INTRO_MS = 2200;

    const el = document.querySelector<HTMLElement>('[data-typewriter]');
    const phrases: string[] = el ? JSON.parse(el.dataset.typewriter ?? '[]') : [];

    if (el && phrases.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const text = document.createElement('span');
      const caret = document.createElement('span');
      caret.className = 'hero-type-caret';
      const wait = (ms: number) => new Promise((resolve) => window.setTimeout(resolve, ms));

      const run = async () => {
        await wait(INTRO_MS);
        text.textContent = phrases[0];
        el.replaceChildren(text, caret);
        el.classList.add('is-typing');
        // Code points, so ZWNJ and surrogate pairs come and go as single steps
        let index = 0;
        for (;;) {
          await wait(HOLD_MS);
          const current = [...phrases[index]];
          for (let n = current.length - 1; n >= 0; n--) {
            text.textContent = current.slice(0, n).join('');
            await wait(ERASE_MS);
          }
          index = (index + 1) % phrases.length;
          const next = [...phrases[index]];
          await wait(250);
          for (let n = 1; n <= next.length; n++) {
            text.textContent = next.slice(0, n).join('');
            await wait(TYPE_MS);
          }
        }
      };
      run();
    }
  </script>
</section>
