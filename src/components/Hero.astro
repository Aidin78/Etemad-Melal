---
import { siteConfig } from '../config/site';
---

<section
  class="hero-intro relative overflow-hidden mesh-gradient max-sm:flex max-sm:min-h-[calc(100dvh-4.5rem)] max-sm:flex-col max-sm:justify-center sm:min-h-[92vh]"
>
  <div class="absolute inset-0 grid-pattern opacity-60" aria-hidden="true"></div>
  <div class="absolute inset-0">
    <img
      src="/images/hero.jpg"
      alt=""
      class="h-full w-full object-cover opacity-25"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-secondary/40 via-secondary/80 to-[#0b1219]"></div>
  </div>

  <div
    class="relative mx-auto flex w-full max-w-6xl flex-col items-center justify-center px-4 py-6 text-center sm:px-6 sm:py-0 sm:pb-24 sm:pt-28"
  >
    <span
      class="reveal mb-4 inline-flex items-center justify-center gap-2 rounded-full border border-accent-gold/40 bg-accent-gold/10 px-4 py-1.5 text-xs font-semibold text-accent-gold-light sm:mb-6"
    >
      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"></span>
      پلتفرم سرمایه‌گذاری اعتماد ملل
    </span>

    <h1
      class="reveal mx-auto max-w-4xl text-3xl font-bold leading-tight text-white sm:mb-0 sm:text-5xl lg:text-6xl"
      style="animation-delay: 0.1s"
    >
      سرمایه‌گذاری هوشمند با
      <span class="bg-gradient-to-l from-accent-gold-light via-accent to-primary-light bg-clip-text text-transparent">
        شفافیت و اطمینان
      </span>
    </h1>

    <p
      class="reveal mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-zinc-300 sm:mt-6 sm:text-lg"
      style="animation-delay: 0.2s"
    >
      {siteConfig.tagline}. با پنل کاربری پیشرفته، وضعیت سرمایه‌گذاری خود را به‌صورت لحظه‌ای
      مشاهده و مدیریت کنید.
    </p>

    <div
      class="reveal mt-6 flex w-full flex-wrap items-center justify-center gap-3 sm:mt-10 sm:gap-4"
      style="animation-delay: 0.3s"
    >
      <a href={siteConfig.panelUrl} class="btn-primary">
        {siteConfig.panelCtaStart}
        <svg class="h-4 w-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a href="#features" class="btn-outline">بیشتر بدانید</a>
    </div>

    <div
      class="reveal mt-6 grid w-full max-w-3xl grid-cols-3 gap-2 sm:mt-16 sm:gap-8"
      style="animation-delay: 0.4s"
    >
      <div class="investment-card rounded-xl p-3 text-center sm:rounded-2xl sm:p-6">
        <p class="stat-value text-xl sm:text-3xl">+۵</p>
        <p class="mt-0.5 text-[10px] text-zinc-400 sm:mt-1 sm:text-sm">سال فعالیت</p>
      </div>
      <div class="investment-card rounded-xl p-3 text-center sm:rounded-2xl sm:p-6">
        <p class="stat-value text-xl sm:text-3xl">۱۰۰٪</p>
        <p class="mt-0.5 text-[10px] text-zinc-400 sm:mt-1 sm:text-sm">شفافیت گزارش</p>
      </div>
      <div class="investment-card rounded-xl p-3 text-center sm:rounded-2xl sm:p-6">
        <p class="stat-value text-xl sm:text-3xl">۲۴/۷</p>
        <p class="mt-0.5 text-[10px] text-zinc-400 sm:mt-1 sm:text-sm">پشتیبانی</p>
      </div>
    </div>
  </div>
</section>
