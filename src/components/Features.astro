---
import OrbitMark from './OrbitMark.astro';
import Photo from './Photo.astro';
import HomeSectionHead from './HomeSectionHead.astro';
import { siteImages } from '../config/images';
import { featureStepIcons } from '../lib/section-icons';
import type { Locale } from '../i18n/types';
import { getTranslations, formatBoxIndex } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const total = formatBoxIndex(t.features.steps.length, locale);
---

<section id="features" class="home-section band-dark story" data-active="0" data-pointer>
  <OrbitMark class="orbit-mark--story" />
  <div class="home-wrap">
    <HomeSectionHead
      locale={locale}
      index={2}
      badge={t.features.badge}
      title={t.features.title}
      titleAccent={t.features.titleAccent}
      subtitle={t.features.subtitle}
    />

    <div class="story-layout">
      <div class="story-sticky">
        <div class="story-frame" data-reveal="image">
          <Photo src={siteImages.features} alt={t.features.imageAlt} class="story-img" loading="lazy" sizes="(min-width: 1024px) 38vw, 100vw" />
          <div class="story-frame-shade" aria-hidden="true"></div>

          <div class="story-counter" aria-hidden="true">
            <div class="story-counter-nums">
              {t.features.steps.map((step) => <span>{step.num}</span>)}
            </div>
            <span class="story-counter-total">/ {total}</span>
          </div>

          <div class="story-frame-icons" aria-hidden="true">
            {t.features.steps.map((_, i) => (
              <span>
                <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d={featureStepIcons[i] ?? featureStepIcons[0]} />
                </svg>
              </span>
            ))}
          </div>

          {
            t.features.chartLabel && (
              <div class="story-chart-note">
                <span class="text-muted">{t.features.chartLabel}</span>
                <span class="font-bold text-accent">{t.features.chartValue}</span>
              </div>
            )
          }
        </div>
        <div class="story-segments" aria-hidden="true">
          {t.features.steps.map(() => <i />)}
        </div>
      </div>

      <ol class="story-steps" data-scrub="line" data-scrub-line="0.55">
        {
          t.features.steps.map((step, i) => (
            <li class="story-step" data-step={i}>
              <span class="story-step-num" aria-hidden="true">{step.num}</span>
              <div class="story-step-body" data-reveal>
                <h3 class="story-step-title">{step.title}</h3>
                <p class="story-step-desc">{step.desc}</p>
              </div>
              <svg class="story-step-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" d={featureStepIcons[i] ?? featureStepIcons[0]} />
              </svg>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  // Highlights the step crossing the middle of the viewport and syncs the sticky frame to it.
  document.querySelectorAll<HTMLElement>('.story').forEach((section) => {
    const steps = section.querySelectorAll<HTMLElement>('.story-step');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const index = (entry.target as HTMLElement).dataset.step ?? '0';
          section.dataset.active = index;
          steps.forEach((step) => step.classList.toggle('is-active', step.dataset.step === index));
        });
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    steps.forEach((step) => observer.observe(step));
    steps[0]?.classList.add('is-active');
  });
</script>
