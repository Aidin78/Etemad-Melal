---
import type { Locale } from '../i18n/types';
import { getTranslations, localePath } from '../i18n';
import LogoIcon from './LogoIcon.astro';

interface Props {
  locale?: Locale;
  showText?: boolean;
  size?: 'sm' | 'md' | 'lg';
  animated?: boolean;
  class?: string;
}

const { locale = 'fa', showText = true, size = 'md', animated = true, class: className = '' } = Astro.props;
const t = getTranslations(locale);
---

<a
  href={localePath(locale, '/')}
  class:list={['group inline-flex items-center gap-3 text-heading transition-opacity hover:opacity-95', className]}
>
  <LogoIcon alt={t.siteName} size={size} animated={animated} />
  {
    showText && (
      <span class="flex min-w-0 flex-col leading-tight">
        <span class="text-base font-bold tracking-tight sm:text-lg">{t.siteName}</span>
        <span class="hidden text-[10px] font-medium text-gold-soft sm:block sm:text-xs">{t.footer.taglineSub}</span>
      </span>
    )
  }
</a>
