---
import SectionHeader from './SectionHeader.astro';
import { siteConfig } from '../config/site';
import type { Locale } from '../i18n/types';
import { getTranslations, localePath } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const formAction = siteConfig.contactFormUrl;
const thankYouUrl = new URL(`${localePath(locale, '/?contact=sent#contact')}`, Astro.url.origin).href;
const isSent = Astro.url.searchParams.get('contact') === 'sent';
---

<section id="contact" class="section-spacing">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeader
      badge={t.contact.badge}
      title={t.contact.title}
      titleAccent={t.contact.titleAccent}
      subtitle={t.contact.subtitle}
      align="center"
    />

    <div class="section-body-gap grid gap-8 lg:grid-cols-2 lg:gap-10">
      <div class="contact-card investment-card rounded-2xl p-5 sm:p-8">
        <h3 class="text-lg font-bold text-heading">{t.contact.infoTitle}</h3>
        <ul class="mt-6 space-y-5">
          <li class="flex gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-accent-gold/25 to-accent/15 text-accent-gold-light">✉</span>
            <div>
              <p class="text-xs text-subtle">{t.contact.emailLabel}</p>
              <a href={`mailto:${t.contact.email}`} class="text-sm text-heading hover:text-accent-gold-light">{t.contact.email}</a>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-accent-gold/25 to-accent/15 text-accent-gold-light">⌖</span>
            <div>
              <p class="text-xs text-subtle">{t.contact.addressLabel}</p>
              <p class="text-sm text-heading">{t.contact.address}</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="contact-card investment-card rounded-2xl p-5 sm:p-8">
        {
          isSent ? (
            <div class="flex flex-col items-center justify-center py-8 text-center">
              <div class="flex h-14 w-14 items-center justify-center rounded-full bg-accent/20 text-2xl text-accent">✓</div>
              <h3 class="mt-4 text-lg font-bold text-heading">{t.contact.sentTitle}</h3>
              <p class="mt-2 max-w-sm text-sm text-muted">{t.contact.sentBody}</p>
              <a href={localePath(locale, '/#contact')} class="btn-outline mt-6">{t.contact.sentNew}</a>
            </div>
          ) : (
            <>
              <h3 class="text-lg font-bold text-heading">{t.contact.formTitle}</h3>
              <p class="mt-2 text-sm text-muted">{t.contact.formHint}</p>
              <form class="mt-6 space-y-4" method="POST" action={formAction}>
                <input type="hidden" name="_subject" value={`Contact from ${t.siteName} website`} />
                <input type="hidden" name="_next" value={thankYouUrl} />
                <input type="hidden" name="_captcha" value="false" />
                <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />
                <div>
                  <label for="contact-email" class="mb-1 block text-xs text-muted">{t.contact.emailField}</label>
                  <input type="email" id="contact-email" name="email" required autocomplete="email" class="input-field w-full rounded-xl px-4 py-3 text-base outline-none transition sm:py-2.5 sm:text-sm" />
                </div>
                <div>
                  <label for="contact-message" class="mb-1 block text-xs text-muted">{t.contact.messageField}</label>
                  <textarea id="contact-message" name="message" rows="4" required class="input-field w-full resize-none rounded-xl px-4 py-3 text-base outline-none transition sm:py-2.5 sm:text-sm"></textarea>
                </div>
                <button type="submit" class="btn-primary w-full">{t.contact.submit}</button>
              </form>
            </>
          )
        }
      </div>
    </div>
  </div>
</section>
