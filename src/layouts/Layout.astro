---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { siteConfig } from '../config/site';
import { siteImages } from '../config/images';
import { THEME_STORAGE_KEY, themeColors } from '../config/theme';
import type { Locale } from '../i18n/types';
import { getTranslations, alternateLocalePath, localeHreflang, ogLocale } from '../i18n';
import { defaultLocale } from '../i18n/utils';

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Footer's call-to-action band; off on pages that close with their own */
  footerCta?: boolean;
}

const {
  locale = defaultLocale,
  title,
  description,
  image = siteImages.hero,
  ogType = 'website',
  publishedTime,
  jsonLd,
  noindex = false,
  footerCta = true,
} = Astro.props;

const t = getTranslations(locale);
const pageTitle = title ?? t.siteName;
const fullTitle = pageTitle === t.siteName ? pageTitle : `${pageTitle} | ${t.siteName}`;
const metaDescription = description ?? t.description;
const canonical = new URL(Astro.url.pathname, siteConfig.url).href;
const ogImage = new URL(image, siteConfig.url).href;
const altLocale = locale === 'fa' ? 'en' : 'fa';
const altPath = alternateLocalePath(locale, Astro.url.pathname);
const altUrl = new URL(altPath, siteConfig.url).href;
const defaultUrl = locale === defaultLocale ? canonical : altUrl;
---

<!doctype html>
<html lang={t.lang} dir={t.dir} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={metaDescription} />
    <meta name="author" content={t.companyLegal} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content={themeColors.dark} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={themeColors.light} media="(prefers-color-scheme: light)" />
    <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY, themeColors }}>
      var r = document.documentElement;
      var s = null;
      try {
        s = localStorage.getItem(storageKey);
      } catch (e) {
        // Blocked site data: fall through to the system preference
      }
      var t =
        s === 'light' || s === 'dark'
          ? s
          : window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
      r.setAttribute('data-theme', t);
      document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
        m.setAttribute('content', themeColors[t]);
      });

      // Scroll-reveal hidden states (motion.css) only apply under .js-motion; drop it
      // again if the motion script never boots so content can't stay hidden.
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        r.classList.add('js-motion');
        setTimeout(function () {
          if (!window.__emMotion) r.classList.remove('js-motion');
        }, 3000);
      }
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={localeHreflang(locale)} href={canonical} />
    <link rel="alternate" hreflang={localeHreflang(altLocale)} href={altUrl} />
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Site summary for AI systems" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:locale:alternate" content={ogLocale(altLocale)} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={pageTitle} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <title>{fullTitle}</title>
    <slot name="head" />
    {jsonLd && <JsonLd data={jsonLd} />}
  </head>
  <body class="relative min-h-screen">
    <div class="scroll-progress" aria-hidden="true"></div>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-accent-gold focus:px-4 focus:py-2 focus:text-secondary focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-secondary"
    >
      {t.a11y.skipToContent}
    </a>
    <Header locale={locale} />
    <main id="main-content" class="site-main relative z-[1]">
      <slot />
    </main>
    <Footer locale={locale} cta={footerCta} />
    <script>
      import { initHeader } from '../scripts/header';
      import { initMotion } from '../scripts/motion';
      initHeader();
      initMotion();
    </script>
  </body>
</html>
