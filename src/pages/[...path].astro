---
import HomePage from '../components/HomePage.astro';
import AboutPage from '../components/AboutPage.astro';
import ArticlesIndexPage from '../components/ArticlesIndexPage.astro';
import ArticlePage from '../components/ArticlePage.astro';
import { getCatchAllPagePaths, type PageRouteProps } from '../lib/routes';

export const getStaticPaths = getCatchAllPagePaths;

const props = Astro.props as PageRouteProps;
---

{props.type === 'home' && <HomePage locale={props.locale} />}
{props.type === 'about' && <AboutPage locale={props.locale} />}
{props.type === 'articles' && <ArticlesIndexPage locale={props.locale} />}
{props.type === 'article' && <ArticlePage locale={props.locale} post={props.post} />}
