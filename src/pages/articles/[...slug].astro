---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../config/site';
import { articleSchema, breadcrumbSchema } from '../../lib/seo-schemas';

export async function getStaticPaths() {
  const posts = await getCollection('articles');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const articleUrl = new URL(`/articles/${post.id}`, siteConfig.url).href;
---

<Layout
  title={post.data.title}
  description={post.data.excerpt}
  image={post.data.image}
  ogType="article"
  publishedTime={post.data.date}
  jsonLd={[
    articleSchema({
      title: post.data.title,
      description: post.data.excerpt,
      image: post.data.image,
      datePublished: post.data.date,
      url: articleUrl,
    }),
    breadcrumbSchema([
      { name: 'خانه', url: siteConfig.url },
      { name: 'مقالات', url: `${siteConfig.url}/articles` },
      { name: post.data.title, url: articleUrl },
    ]),
  ]}
>
  <article itemscope itemtype="https://schema.org/Article">
    <header class="relative overflow-hidden mesh-gradient py-16 sm:py-24">
      <div class="absolute inset-0" aria-hidden="true">
        <img
          src={post.data.image}
          alt=""
          class="h-full w-full object-cover opacity-20"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0b1219] to-transparent"></div>
      </div>
      <div class="relative mx-auto max-w-3xl px-4 sm:px-6">
        <nav aria-label="مسیر صفحه">
          <a href="/articles" class="text-sm text-primary-light hover:text-accent">← بازگشت به مقالات</a>
        </nav>
        <time
          class="mt-4 block text-sm text-zinc-500"
          datetime={post.data.date.toISOString()}
          itemprop="datePublished"
        >
          {post.data.dateFa}
        </time>
        <h1 class="mt-2 text-3xl font-bold text-white sm:text-4xl" itemprop="headline">{post.data.title}</h1>
        <p class="mt-4 text-lg text-zinc-400" itemprop="description">{post.data.excerpt}</p>
      </div>
    </header>

    <div
      class="article-prose prose prose-invert prose-headings:text-white prose-a:text-primary-light mx-auto max-w-3xl px-4 py-12 sm:px-6 prose-p:text-zinc-300"
      itemprop="articleBody"
    >
      <Content />
    </div>
  </article>
</Layout>
