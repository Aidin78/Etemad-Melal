---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  title="مقالات"
  description="مقالات آموزشی اعتماد ملل: راهنمای سرمایه‌گذاری، پکیج‌ها، سود ماهانه، پاداش مشارکت و مدیریت حساب در پنل کاربری."
>
  <section class="mesh-gradient py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6">
      <span class="section-badge">مجله سرمایه‌گذاری</span>
      <h1 class="mt-4 text-4xl font-bold text-heading sm:text-5xl">
        <span class="section-title-accent">مقالات</span> اعتماد ملل
      </h1>
      <p class="mt-4 text-muted">راهنماها و مطالب آموزشی برای سرمایه‌گذاری هوشمند</p>
    </div>
  </section>

  <section class="pb-20 pt-8">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:grid-cols-2 sm:px-6 lg:grid-cols-2">
      {posts.map((post) => <NewsCard post={post} />)}
    </div>
  </section>
</Layout>

