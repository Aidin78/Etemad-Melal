---
import { getCollection } from 'astro:content';
import { parseArticleId } from '../../lib/article-utils';

export async function getStaticPaths() {
  const posts = await getCollection('articles');
  return posts
    .filter((post) => parseArticleId(post.id).locale === 'fa')
    .map((post) => ({
      params: { slug: parseArticleId(post.id).slug },
    }));
}

return Astro.redirect(`/articles/${Astro.params.slug}`);
---
