---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import InvestmentTicker from '../components/InvestmentTicker.astro';
import IncomeStreams from '../components/IncomeStreams.astro';
import Features from '../components/Features.astro';
import Packages from '../components/Packages.astro';
import Trust from '../components/Trust.astro';
import About from '../components/About.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import NewsPreview from '../components/NewsPreview.astro';
import { siteConfig } from '../config/site';
---

<Layout title={siteConfig.name} description={siteConfig.description}>
  <Hero />
  <InvestmentTicker />
  <IncomeStreams />
  <Features />
  <Packages />
  <Trust />
  <About />
  <NewsPreview />
  <FAQ />
  <Contact />
</Layout>
